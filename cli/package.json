{
  "name": "@loopress/cli",
  "description": "CLI tool for syncing WordPress code snippets, plugins, and Composer dependencies via the REST API",
  "version": "0.28.0",
  "author": "jean-smaug",
  "bin": {
    "loopress": "bin/run.js",
    "lps": "bin/run.js"
  },
  "bugs": {
    "url": "https://github.com/loopress/loopress/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@oclif/core": "^5.1.2",
    "@oclif/plugin-help": "^7.0.2",
    "@oclif/plugin-warn-if-update-available": "^4.0.1",
    "@sentry/node": "^10.74.0",
    "chokidar": "^5.0.0",
    "compare-versions": "^6.1.1",
    "diff": "^9.0.0",
    "got": "^16.0.0",
    "listr2": "^11.1.1",
    "microdiff": "^1.6.0",
    "open": "^11.0.4",
    "playwright-core": "^1.63.0",
    "slugify": "^1.6.9",
    "tty-table": "^5.0.0",
    "write-file-atomic": "^8.0.0"
  },
  "devDependencies": {
    "@oclif/prettier-config": "^0.2.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "26.6.4",
    "@types/write-file-atomic": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-oclif": "^7.1.8",
    "eslint-config-prettier": "^10",
    "eslint-plugin-sonarjs": "^4.2.2",
    "json-schema-to-typescript": "^16.0.0",
    "oclif": "^6.0.2",
    "prettier": "3.9.9",
    "shx": "^0.4.0",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./schemas",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/loopress/loopress",
  "keywords": [
    "oclif"
  ],
  "license": "MPL-2.0",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./schema/global-config": "./schemas/global-config.schema.json",
    "./schema/project-config": "./schemas/project-config.schema.json",
    "./schema/snippet": "./schemas/snippet.schema.json"
  },
  "type": "module",
  "oclif": {
    "bin": "lps",
    "binAliases": [
      "loopress",
      "lps"
    ],
    "dirname": "loopress",
    "commands": "./dist/commands",
    "helpClass": "./dist/help.js",
    "hooks": {
      "finally": "./dist/hooks/finally.js",
      "init": "./dist/hooks/init.js"
    },
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-warn-if-update-available"
    ],
    "warn-if-update-available": {
      "timeoutInDays": 1,
      "frequency": 1,
      "frequencyUnit": "days",
      "message": "<%= config.name %> update available: <%= latest %> (you have <%= config.version %>). The CLI and the WordPress plugin evolve together, staying current avoids already-fixed bugs. Update with: npm install -g @loopress/cli"
    },
    "topicSeparator": " ",
    "topics": {
      "acf": {
        "description": "Manage ACF field groups, post types, taxonomies, and options pages"
      },
      "api": {
        "description": "Manage custom WordPress REST API routes"
      },
      "composer": {
        "description": "Sync composer.json and composer.lock between your project and WordPress"
      },
      "plugin": {
        "description": "Manage WordPress.org plugins tracked in loopress.json"
      },
      "project": {
        "description": "Manage WordPress project and environment configurations"
      },
      "seo": {
        "description": "Manage SEO settings, post meta, and redirects (RankMath or Yoast SEO, whichever is active)"
      },
      "snippet": {
        "description": "Manage WordPress code snippets"
      },
      "theme": {
        "description": "Manage everything theme related: versions, block templates and parts, Global Styles (never switches the active theme)"
      },
      "theme:template": {
        "description": "Manage block templates and template parts, written as the files of the <parent>-loopress child theme"
      },
      "theme:version": {
        "description": "Manage WordPress.org themes tracked in loopress.json (versions only)"
      },
      "theme:style": {
        "description": "Manage the active block theme's Global Styles customizations (Site Editor > Styles: colors, typography, spacing)"
      },
      "telemetry": {
        "description": "Manage error reporting preferences"
      }
    },
    "repositoryPrefix": "<%- repo %>/blob/%40loopress%2Fcli%40<%- version %>/cli/<%- commandPath %>"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopress/loopress.git"
  },
  "scripts": {
    "prewatch": "pnpm run schema:types",
    "watch": "tsc -b --watch",
    "build": "shx rm -rf dist && pnpm run schema:types && tsc -b",
    "prelint": "pnpm run schema:types",
    "lint": "eslint",
    "pretest": "pnpm run schema:types",
    "posttest": "pnpm run lint",
    "schema:types": "tsx scripts/generate-config-types.ts",
    "prepack": "oclif manifest && oclif readme",
    "test": "vitest run",
    "typecheck:test": "tsc -p test/tsconfig.json",
    "pretest:mutation": "pnpm run schema:types",
    "test:mutation": "stryker run",
    "version": "oclif manifest && oclif readme && git add README.md oclif.manifest.json",
    "format": "prettier . --write"
  },
  "types": "dist/index.d.ts",
  "directories": {
    "test": "test"
  }
}
