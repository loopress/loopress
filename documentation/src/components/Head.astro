---
import Default from "@astrojs/starlight/components/Head.astro";
import Analytics from "@vercel/analytics/astro";

// Default social card for every page. Starlight emits `twitter:card` as
// `summary_large_image` but no image, so shared links would show a bare card.
const ogImage = new URL("/og-image.png", Astro.site ?? Astro.url).href;
const ogAlt = "Loopress: version control for WordPress configuration and code";
// Thin blog listings (tags, authors, pagination) stay out of the index; they are also
// filtered from the sitemap in astro.config.mjs.
const path = Astro.url.pathname;
const isThinBlogListing = /^\/blog\/((tags|authors)\/|\d+\/?$)/.test(path);
const isBlogIndex = path === "/blog/" || path === "/blog";
---

<Default {...Astro.props} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />
{isThinBlogListing && <meta name="robots" content="noindex, follow" />}
{
	isBlogIndex && (
		<meta
			name="description"
			content="Articles on versioning WordPress configuration and code with Git: custom REST API routes, Composer, hooks, snippets and deployment workflows."
		/>
	)
}
<Analytics />
