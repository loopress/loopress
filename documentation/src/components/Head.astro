---
import Default from "@astrojs/starlight/components/Head.astro";
import Analytics from "@vercel/analytics/astro";

// Default social card for every page. Starlight emits `twitter:card` as
// `summary_large_image` but no image, so shared links would show a bare card.
const ogImage = new URL("/og-image.png", Astro.site ?? Astro.url).href;
const ogAlt = "Loopress: version control for WordPress configuration and code";
---

<Default {...Astro.props} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />
<Analytics />
