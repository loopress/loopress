---
import { LinkButton } from '@astrojs/starlight/components';
import pkg from '../../../wordpress-plugin/package.json';

interface Props {
  edition?: 'light' | 'full';
}

const { edition = 'light' } = Astro.props;

const version = pkg.version;
const encodedTag = `wordpress-plugin%40${version}`;

// Loopress Light is on the WordPress.org directory; Loopress Full is a GitHub release asset.
const buttons =
  edition === 'full'
    ? {
        primary: {
          href: `https://github.com/loopress/loopress/releases/download/${encodedTag}/loopress-full.zip`,
          icon: 'download',
          label: 'Download loopress-full.zip',
        },
        secondary: {
          href: `https://github.com/loopress/loopress/releases/tag/${encodedTag}`,
          icon: 'github',
          label: `v${version} release notes`,
        },
      }
    : {
        primary: {
          href: 'https://wordpress.org/plugins/loopress-light/',
          icon: 'external',
          label: 'Loopress Light on WordPress.org',
        },
        secondary: {
          href: 'https://downloads.wordpress.org/plugin/loopress-light.zip',
          icon: 'download',
          label: 'Download loopress-light.zip',
        },
      };
---

<div class="plugin-download">
  <LinkButton href={buttons.primary.href} icon={buttons.primary.icon} variant="primary">
    {buttons.primary.label}
  </LinkButton>
  <LinkButton href={buttons.secondary.href} icon={buttons.secondary.icon} variant="minimal">
    {buttons.secondary.label}
  </LinkButton>
</div>

<style>
  .plugin-download {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
</style>
