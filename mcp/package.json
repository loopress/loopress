{
  "name": "@loopress/mcp",
  "description": "MCP server exposing Loopress CLI operations (snippet/page/api/acf/seo/form/plugin/composer push/pull, push-all/pull-all, project status) as tool calls for AI agents",
  "version": "0.24.0",
  "type": "module",
  "bin": {
    "lps-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "dev": "tsx src/server.ts",
    "lint": "eslint",
    "test": "vitest run",
    "posttest": "pnpm run lint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@loopress/eslint-config": "workspace:*",
    "@types/node": "26.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10",
    "prettier": "3.9.6",
    "shx": "^0.4.0",
    "tsx": "4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "license": "MPL-2.0"
}
