{
  "name": "@loopress/mcp",
  "description": "MCP server exposing Loopress CLI operations (snippet/page/api/acf/seo/form/plugin/composer push/pull, push-all/pull-all, promote, project status) as tool calls for AI agents",
  "version": "0.29.0",
  "type": "module",
  "bin": {
    "lps-mcp": "dist/server.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "dev": "tsx src/server.ts",
    "lint": "eslint",
    "test": "vitest run",
    "posttest": "pnpm run lint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "tinyexec": "^1.3.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@loopress/cli": "*"
  },
  "peerDependenciesMeta": {
    "@loopress/cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@loopress/cli": "workspace:*",
    "@loopress/eslint-config": "workspace:*",
    "@types/node": "26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10",
    "prettier": "3.9.9",
    "shx": "^0.4.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "license": "MPL-2.0"
}
