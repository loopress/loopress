{
  "name": "@loopress/mcp",
  "description": "MCP server exposing the Loopress CLI (lps) as tool calls for AI agents: pull, diff, push and roll back a WordPress site's code and config, with a confirmed preview before every change",
  "version": "0.33.0",
  "author": "jean-smaug",
  "bugs": {
    "url": "https://github.com/loopress/loopress/issues"
  },
  "homepage": "https://docs.loopress.dev/cli/mcp/",
  "keywords": [
    "mcp",
    "wordpress",
    "loopress",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopress/loopress.git",
    "directory": "mcp"
  },
  "type": "module",
  "bin": {
    "lps-mcp": "dist/server.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "dev": "tsx src/server.ts",
    "lint": "eslint",
    "test": "vitest run",
    "posttest": "pnpm run lint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tinyexec": "^1.3.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@loopress/cli": "*"
  },
  "peerDependenciesMeta": {
    "@loopress/cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@loopress/cli": "workspace:*",
    "@loopress/eslint-config": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10",
    "prettier": "3.9.10",
    "shx": "^0.4.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "license": "MPL-2.0"
}
