{
  "compilerOptions": {
    "declaration": true,
    "skipLibCheck": true,
    "module": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUncheckedSideEffectImports": true,
    "target": "es2022",
    "moduleResolution": "node16",
    "types": ["node"]
  },
  "include": ["./src/**/*"]
}
