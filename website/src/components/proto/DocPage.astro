---
// Shared frame for the /proto content pages (faq, contact, brand-assets, privacy, terms): loop-12's
// header, footer and palette around a single reading column. Throwaway, like the rest of /proto.
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/proto/Logo.astro";
import Footer from "@/components/proto/Footer.astro";

const { title, kicker, heading, lede, wide = false } = Astro.props as {
  title: string;
  kicker: string;
  heading: string;
  lede?: string;
  wide?: boolean;
};
---

<Layout title={title}>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=JetBrains+Mono:wght@500&display=swap" />

  <div class="page">
    <header class="wrap flex items-center justify-between gap-4 py-6">
      <a href="/proto/loop-12" class="text-lg font-extrabold"><Logo class="h-9 w-9" /></a>
      <nav class="topnav hidden text-sm font-medium md:flex">
        <a href="/proto/loop-12#scope">What's in Git</a><a href="/proto/loop-12#week">A week in the loop</a><a href="/proto/loop-12#editions">Light & Full</a><a href="https://docs.loopress.dev">Docs</a>
      </nav>
      <a href="https://github.com/loopress" class="mono text-xs">★ GitHub</a>
    </header>

    <main class:list={["wrap doc", { "doc-wide": wide }]}>
      <p class="mono kicker">{kicker}</p>
      <h1>{heading}</h1>
      {lede && <p class="lede">{lede}</p>}
      <div class="body"><slot /></div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .page {
    --paper: oklch(0.975 0.008 95);
    --navy: oklch(0.22 0.05 255);
    --cyan: oklch(0.76 0.14 215);
    --cyan-ink: oklch(0.5 0.12 225);
    --yellow: oklch(0.88 0.16 95);
    --font-display: "Bricolage Grotesque", system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
    --logo-accent: var(--cyan);
    min-height: 100vh;
    background: var(--paper);
    color: var(--navy);
    font-family: var(--font-display);
    overflow-x: clip;
  }
  .wrap { margin-inline: auto; max-width: 72rem; padding-inline: 1.5rem; }
  .mono { font-family: var(--font-mono); }
  a:hover { color: var(--cyan-ink); }
  .topnav { gap: 1.75rem; }

  .doc { max-width: 44rem; padding-block: 4rem 7rem; }
  .doc-wide { max-width: 56rem; }
  .kicker { font-size: 0.8rem; color: var(--cyan-ink); }
  h1 { margin-top: 0.75rem; font-size: clamp(2.4rem, 5vw, 3.75rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1; }
  .lede { margin-top: 1.5rem; font-size: 1.15rem; line-height: 1.6; }
  .body { margin-top: 3.5rem; font-size: 1.05rem; line-height: 1.65; }

  /* Page content is slotted, so these reach into it. */
  .body :global(h2) { margin-top: 3.5rem; font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; }
  .body :global(h2:first-child) { margin-top: 0; }
  .body :global(h3) { font-size: 1.15rem; font-weight: 800; letter-spacing: -0.01em; }
  .body :global(p + p), .body :global(* + ul) { margin-top: 1rem; }
  .body :global(h2 + p), .body :global(h2 + ul) { margin-top: 1rem; }
  .body :global(ul) { list-style: disc; padding-left: 1.25rem; }
  .body :global(li + li) { margin-top: 0.5rem; }
  .body :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .body :global(code) { font-family: var(--font-mono); font-size: 0.85em; }
  .body :global(pre) { margin-top: 1.25rem; background: var(--navy); color: var(--paper); border-radius: 0.75rem; padding: 1.25rem 1.5rem; font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.75; white-space: pre-wrap; }
  .body :global(.aside) { font-weight: 500; color: var(--cyan-ink); }
  .body :global(.aside)::before { content: "// "; font-family: var(--font-mono); opacity: 0.7; }
</style>
