---
// Loopress mark, inlined from @loopress/assets/loopress-logo-black.svg. The dark half follows
// currentColor so it works on any background; the cyan half reads --logo-accent.
// Variants (see the dev gallery, /proto/gallery). The mark itself never changes, only the lockup
// or the treatment around it:
// - horizontal (default, in use): mark + wordmark side by side. `wordmark={false}` for the mark alone.
// - stacked: mark above the wordmark, for square spots (social card, sticker).
// - mono: both halves in currentColor, for one-colour print or embossing.
// - outline: the mark's contour only.
// - inline-o: the mark replaces the first "o" of the wordmark, the loop inside the name.
// - badge: the mark on a navy hexagon tile, app icon or avatar.
// - animated: a dot travels around the mark, the loop in motion. Static under reduced motion.
const {
  class: className = "h-7 w-7",
  wordmark = true,
  label = "loopress",
  variant = "horizontal",
} = Astro.props as {
  class?: string;
  wordmark?: boolean;
  label?: string;
  variant?: "horizontal" | "stacked" | "mono" | "outline" | "inline-o" | "badge" | "animated";
};

const repoHalf =
  "M 262.00,92.59 Q 265.00,87.40 259.00,87.40 L 141.00,87.40 Q 135.00,87.40 132.00,92.60 L 73.00,194.80 Q 70.00,200.00 73.00,205.20 L 132.00,307.40 Q 135.00,312.60 141.00,312.60 L 259.00,312.60 Q 265.00,312.60 262.00,307.41 L 250.19,286.99 Q 247.19,281.80 241.34,281.72 L 158.66,281.72 Q 152.81,281.80 149.96,276.70 L 108.53,205.01 Q 105.53,200.00 108.53,194.99 L 149.96,123.30 Q 152.81,118.20 158.66,118.28 L 241.34,118.28 Q 247.19,118.20 250.19,113.01 L 262.00,92.59 Z";
const siteHalf =
  "M 262.00,307.41 Q 265.00,312.60 268.00,307.40 L 327.00,205.20 Q 330.00,200.00 327.00,194.80 L 268.00,92.60 Q 265.00,87.40 262.00,92.59 L 250.19,113.01 Q 247.19,118.20 250.04,123.30 L 291.47,194.99 Q 294.47,200.00 291.47,205.01 L 250.04,276.70 Q 247.19,281.80 250.19,286.99 L 262.00,307.41 Z";

// Midline of the mark's band (outer edge ~130, inner ~92 from the centre), for the animated dot.
const mid = [0, 60, 120, 180, 240, 300]
  .map((a) => `${(200 + 111 * Math.cos((a * Math.PI) / 180)).toFixed(1)},${(200 + 111 * Math.sin((a * Math.PI) / 180)).toFixed(1)}`)
  .join(" L");
const accent = variant === "mono" ? "currentColor" : "var(--logo-accent, #00BFEC)";
const showWord = wordmark && variant !== "inline-o" && variant !== "badge";
---

{variant === "inline-o" ? (
  <span class="lg-inline" aria-label={label} role="img">
    <span aria-hidden="true">l</span><svg viewBox="54 54 292 292" class="lg-o" aria-hidden="true"><path fill="currentColor" d={repoHalf} /><path fill={accent} d={siteHalf} /></svg><span aria-hidden="true">{label.slice(2)}</span>
  </span>
) : (
  <span class:list={["inline-flex items-center gap-2", { "lg-stacked": variant === "stacked" }]}>
    {variant === "badge" ? (
      <svg viewBox="0 0 400 400" class={className} role="img" aria-label="Loopress">
        <polygon points="390,200 295,364.5 105,364.5 10,200 105,35.5 295,35.5" fill="oklch(0.22 0.05 255)" />
        <g transform="translate(200 200) scale(0.62) translate(-200 -200)">
          <path fill="oklch(0.975 0.008 95)" d={repoHalf} />
          <path fill={accent} d={siteHalf} />
        </g>
      </svg>
    ) : (
      <svg viewBox="54 54 292 292" class={className} aria-hidden={showWord ? "true" : undefined} role={showWord ? undefined : "img"} aria-label={showWord ? undefined : "Loopress"}>
        {variant === "outline" ? (
          <>
            <path fill="none" stroke="currentColor" stroke-width="7" stroke-linejoin="round" d={repoHalf} />
            <path fill="none" stroke={accent} stroke-width="7" stroke-linejoin="round" d={siteHalf} />
          </>
        ) : (
          <>
            <path fill="currentColor" d={repoHalf} />
            <path fill={accent} d={siteHalf} />
          </>
        )}
        {variant === "animated" && (
          <circle r="13" class="lg-dot" fill="oklch(0.88 0.16 95)" stroke="currentColor" stroke-width="5">
            <animateMotion dur="6s" repeatCount="indefinite" path={`M${mid} Z`} />
          </circle>
        )}
      </svg>
    )}
    {showWord && <span>{label}</span>}
  </span>
)}

<style>
  .lg-stacked { flex-direction: column; gap: 0.35rem; }
  .lg-inline { display: inline-flex; align-items: baseline; font-weight: 800; letter-spacing: -0.04em; }
  .lg-o { width: 0.78em; height: 0.78em; margin-inline: 0.02em; align-self: center; transform: translateY(0.06em); }
  @media (prefers-reduced-motion: reduce) {
    .lg-dot { display: none; }
  }
</style>
