---
// Prototype A3: "The Loop", headline full width, then CTA on the left of the loop row.
// Three stages (Build, Review, Ship) in a row, a return arrow underneath. The pull-back story
// sits on that arrow, between Ship and the next Build. Throwaway, not linked.
import Layout from "@/layouts/Layout.astro";
import Stage from "@/dev/components/Stage.astro";

export const prerender = true;

const stages = [
  { id: "build", n: "01", label: "Build", line: "Fields, hooks and routes as files." },
  { id: "review", n: "02", label: "Review", line: "A diff short enough to read in a PR." },
  { id: "ship", n: "03", label: "Ship", line: "Staging, then production. Undo is one command." },
];
---

<Layout title="Loopress - Build, review and ship WordPress, in one loop">
  <div class="min-h-screen bg-background text-foreground">
    <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
      <a href="#top" class="font-mono text-sm font-semibold">loopress</a>
      <nav class="hidden gap-6 font-mono text-xs text-muted-foreground lg:flex">
        {stages.map((s) => <a href={`#${s.id}`} class="hover:text-foreground">{s.n} {s.label}</a>)}
        <a href="#editions" class="hover:text-foreground">Light / Full</a>
      </nav>
      <a href="https://github.com/loopress" class="font-mono text-xs text-muted-foreground hover:text-foreground">GitHub ↗</a>
    </header>

    <main id="top">
      <!-- Hero: pitch, then the loop as a row with a return arrow -->
      <section class="mx-auto max-w-6xl px-6 pt-16 pb-24">
        <p class="font-mono text-xs uppercase tracking-widest text-accent-cyan-ink">Open source · MPL-2.0</p>
        <h1 class="mt-4 max-w-4xl text-balance text-5xl font-semibold tracking-tight md:text-6xl">
          Build, review and ship WordPress, in one loop.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
          Model your content types, write hooks and APIs in modern PHP, review every change in a PR
          and ship it to every environment. Your content never moves.
        </p>
        <div class="mt-16 grid gap-10 lg:grid-cols-[1fr_3fr] lg:items-start">
          <div class="flex flex-col items-start gap-3">
            <code class="rounded-md border border-border bg-card px-4 py-2.5 font-mono text-sm">
              <span class="text-muted-foreground">$</span> npm i -g @loopress/cli
            </code>
            <a href="https://github.com/loopress" class="inline-flex h-10 items-center rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground hover:opacity-90">
              Star on GitHub
            </a>
          </div>

          <div>
            <ol class="grid gap-4 md:grid-cols-3">
              {stages.map((s, i) => (
                <li class="relative">
                  <a href={`#${s.id}`} class="block h-full rounded-xl border border-border bg-card/40 p-5 hover:border-accent-cyan">
                    <span class="font-mono text-xs text-accent-cyan-ink">{s.n}</span>
                    <p class="mt-1 text-xl font-semibold">{s.label}</p>
                    <p class="mt-2 text-sm text-muted-foreground">{s.line}</p>
                  </a>
                  {i < stages.length - 1 && (
                    <span class="absolute top-1/2 -right-3 hidden -translate-y-1/2 font-mono text-muted-foreground md:block" aria-hidden="true">→</span>
                  )}
                </li>
              ))}
            </ol>
            <!-- The return arrow: from Ship back to Build -->
            <div class="relative hidden h-12 md:block" aria-hidden="true">
              <svg viewBox="0 0 600 60" preserveAspectRatio="none" class="absolute inset-0 h-full w-full">
                <path d="M 500 0 V 30 Q 500 50 480 50 H 120 Q 100 50 100 30 V 8" fill="none"
                  stroke="var(--accent-cyan)" stroke-width="1.5" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
                <path d="M 94 14 L 100 4 L 106 14" fill="none" stroke="var(--accent-cyan)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
              </svg>
            </div>
            <p class="mt-4 text-center font-mono text-xs text-muted-foreground md:mt-2">
              <span class="text-accent-cyan-ink">↺</span> Changed in wp-admin since? <code>lps pull</code> and go around again.
            </p>
          </div>
        </div>
      </section>

      <!-- 01 Build -->
      <section id="build" class="border-t border-border/60">
        <div class="mx-auto max-w-6xl px-6 py-24">
          <Stage n="01" label="Build" />
          <h2 class="mt-6 max-w-3xl text-balance text-4xl font-semibold tracking-tight">
            Configuration and code, side by side in one repo.
          </h2>
          <div class="mt-12 grid gap-6 md:grid-cols-2">
            <figure class="rounded-xl border border-border bg-card/50 p-6">
              <figcaption class="flex items-center justify-between font-mono text-xs">
                <span>acf/group_product_delivery.json</span>
                <span class="rounded border border-accent-cyan/40 px-1.5 py-0.5 text-accent-cyan-ink">Config · Light</span>
              </figcaption>
              <pre class="mt-4 overflow-x-auto font-mono text-xs leading-relaxed text-foreground/90">{`{
  "title": "Delivery",
  "fields": [{ "name": "delivery_date", "type": "date_picker" }]
}`}</pre>
            </figure>
            <figure class="rounded-xl border border-border bg-card/50 p-6">
              <figcaption class="flex items-center justify-between font-mono text-xs">
                <span>hooks/vat-notice.php</span>
                <span class="rounded border border-accent-violet/40 px-1.5 py-0.5 text-accent-violet">Code · Full</span>
              </figcaption>
              <pre class="mt-4 overflow-x-auto font-mono text-xs leading-relaxed text-foreground/90">{`#[Filter('woocommerce_get_price_html')]
public function notice(string $html): string
{
    return $html . ' <small>incl. VAT</small>';
}`}</pre>
            </figure>
          </div>
        </div>
      </section>

      <!-- 02 Review -->
      <section id="review" class="border-t border-border/60 bg-card/20">
        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 lg:grid-cols-2 lg:items-start">
          <div>
            <Stage n="02" label="Review" />
            <h2 class="mt-6 text-balance text-4xl font-semibold tracking-tight">See exactly what will change. Nothing else.</h2>
            <p class="mt-4 text-muted-foreground">
              Posts, orders and users are never part of the diff, so it stays short enough to read in a PR.
            </p>
          </div>
          <pre class="overflow-x-auto rounded-xl border border-border bg-background p-6 font-mono text-xs leading-relaxed">{`$ lps diff --env staging

`}<span class="text-success-ink">{`+ acf     group_product_delivery   new`}</span>{`
`}<span class="text-success-ink">{`+ hook    vat-notice.php            new`}</span>{`

2 changes`}</pre>
        </div>
      </section>

      <!-- 03 Ship, then the return arrow as its own band -->
      <section id="ship" class="border-t border-border/60">
        <div class="mx-auto max-w-6xl px-6 py-24">
          <Stage n="03" label="Ship" />
          <h2 class="mt-6 max-w-3xl text-balance text-4xl font-semibold tracking-tight">Staging, then production. On every site, the same way.</h2>
          <div class="mt-12 grid gap-4 md:grid-cols-3">
            {[
              ["lps push --env staging", "Only what changed is applied."],
              ["lps promote staging production", "Copy every tracked resource across."],
              ["lps hook rollback --env production", "Every push is snapshotted. Undo is one command."],
            ].map(([cmd, body]) => (
              <div class="rounded-xl border border-border bg-card/40 p-6">
                <code class="font-mono text-xs text-accent-cyan-ink">$ {cmd}</code>
                <p class="mt-3 text-sm text-muted-foreground">{body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="border-y border-dashed border-accent-cyan/40 bg-card/20">
        <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 lg:grid-cols-[5fr_7fr] lg:items-center">
          <div>
            <p class="font-mono text-xs text-accent-cyan-ink">↺ Ship → Build</p>
            <h2 class="mt-3 text-balance text-3xl font-semibold tracking-tight">
              The client edited a menu in wp-admin. Nothing is lost.
            </h2>
            <p class="mt-3 text-sm text-muted-foreground">
              The live site keeps moving between releases. The diff shows the drift, one pull brings
              it back into the repo, and the next Build starts from the real site.
            </p>
          </div>
          <pre class="overflow-x-auto rounded-xl border border-border bg-background p-6 font-mono text-xs leading-relaxed">{`$ lps diff --env production
`}<span class="text-warning-ink">{`~ menu  primary   1 item added on the site`}</span>{`

$ lps pull --env production
`}<span class="text-success-ink">{`✓ menus/primary.json updated`}</span></pre>
        </div>
      </section>

      <!-- Editions: Full drawn as a box that contains Light, so the inclusion is visible -->
      <section id="editions">
        <div class="mx-auto max-w-6xl px-6 py-24">
          <p class="font-mono text-xs uppercase tracking-widest text-accent-cyan-ink">Two ways into the loop</p>
          <h2 class="mt-4 max-w-3xl text-balance text-4xl font-semibold tracking-tight">
            Start with your configuration. Add your code when you are ready.
          </h2>

          <div class="mt-12 rounded-2xl border border-accent-violet/50 p-6 md:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <div>
                <p class="font-mono text-xs text-accent-violet">Loopress Full</p>
                <h3 class="mt-2 text-2xl font-semibold">Your code, in Git, with conventions.</h3>
              </div>
              <p class="font-mono text-xs text-muted-foreground">Free · from loopress.dev</p>
            </div>

            <div class="mt-8 grid gap-6 md:grid-cols-[5fr_7fr] md:items-stretch">
              <div class="rounded-xl border border-accent-cyan/50 bg-background p-6">
                <p class="font-mono text-xs text-accent-cyan-ink">Loopress Light</p>
                <h4 class="mt-2 text-xl font-semibold">Your configuration, in Git.</h4>
                <ul class="mt-4 flex flex-wrap gap-2 font-mono text-xs">
                  {["ACF", "SEO", "menus", "options", "block theme styles"].map((f) => (
                    <li class="rounded border border-border px-2 py-1">{f}</li>
                  ))}
                </ul>
                <p class="mt-6 font-mono text-xs text-muted-foreground">Free · from Plugins → Add New</p>
              </div>
              <div class="p-2 md:p-6">
                <p class="font-mono text-xs text-accent-violet">+ your code</p>
                <ul class="mt-4 flex flex-wrap gap-2 font-mono text-xs">
                  {["hooks", "API routes", "apps", "pages", "Composer", "plugin lockfile"].map((f) => (
                    <li class="rounded border border-accent-violet/40 px-2 py-1">{f}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <p class="mt-6 max-w-2xl text-sm text-muted-foreground">
            Full is Light with the code half switched on. WordPress.org does not host plugins that
            deploy executable code, so Light is the one in the directory and Full ships from loopress.dev.
          </p>
        </div>
      </section>
    </main>

    <footer class="border-t border-border/60 px-6 py-6 text-center font-mono text-xs text-muted-foreground">
      loopress · MPL-2.0 · docs · github
    </footer>
  </div>
</Layout>
