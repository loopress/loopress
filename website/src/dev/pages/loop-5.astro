---
// Prototype A5 "Atelier": warm paper, an upright serif for display, handwritten margin notes,
// the logo's cyan as the only accent. Reads like a craftsman's notebook, not a SaaS page.
// Throwaway, not linked.
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/site/Logo.astro";
import LoopDiagram from "@/dev/components/LoopDiagram.astro";

export const prerender = true;
---

<Layout title="Loopress - Build, review and ship WordPress, in one loop">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Caveat:wght@500&family=IBM+Plex+Mono:wght@400;500&display=swap" />

  <div class="atelier">
    <header class="wrap flex items-center justify-between py-6">
      <a href="#top" class="text-lg font-semibold"><Logo class="h-8 w-8" /></a>
      <nav class="hidden gap-8 text-sm md:flex">
        <a href="#build">Build</a><a href="#review">Review</a><a href="#ship">Ship</a><a href="#editions">Light & Full</a>
      </nav>
      <a href="https://github.com/loopress" class="mono text-sm">GitHub ↗</a>
    </header>

    <main id="top">
      <section class="wrap grid gap-12 pt-10 pb-24 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center">
        <div>
          <h1 class="display text-6xl md:text-7xl">Build, review and ship WordPress, in one <span class="mark">loop</span>.</h1>
          <p class="mt-8 max-w-xl text-lg leading-relaxed">
            Model your content types, write hooks and APIs in modern PHP, review every change in a PR
            and ship it to every environment. Your content never moves.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <code class="chip">$ npm i -g @loopress/cli</code>
            <a href="https://github.com/loopress" class="btn">Star on GitHub</a>
          </div>
        </div>
        <figure class="relative">
          <LoopDiagram />
          <figcaption class="hand absolute -top-6 right-0 rotate-[-4deg]">the whole idea, on one napkin ↓</figcaption>
        </figure>
      </section>

      <!-- The three stages as a notebook: one column, a margin for notes -->
      <section class="rule">
        <div class="wrap notebook">
          <article id="build">
            <h2 class="display text-4xl">Build.</h2>
            <p>A field is configuration, a hook is code. Both are files in the same repo, next to each other.</p>
            <div class="cards">
              <pre class="card">{`// acf/group_product_delivery.json
{ "title": "Delivery",
  "fields": [{ "name": "delivery_date",
               "type": "date_picker" }] }`}</pre>
              <pre class="card tilt">{`// hooks/vat-notice.php
#[Filter('woocommerce_get_price_html')]
public function notice(string $html): string
{
    return $html . ' <small>incl. VAT</small>';
}`}</pre>
            </div>
          </article>
          <aside class="hand note">one class per file, no more functions.php</aside>

          <article id="review">
            <h2 class="display text-4xl">Review.</h2>
            <p>See exactly what will change, nothing else. Posts, orders and users are never in the diff, so it fits in a PR.</p>
            <pre class="card">{`$ lps diff --env staging
+ acf   group_product_delivery  new
+ hook  vat-notice.php           new
2 changes`}</pre>
          </article>
          <aside class="hand note">exit 1 on drift, so CI can say no</aside>

          <article id="ship">
            <h2 class="display text-4xl">Ship.</h2>
            <p>Staging, then production. Six client sites, one way of doing it.</p>
            <pre class="card">{`$ lps push --env staging
$ lps promote staging production`}</pre>
            <p class="small">Every push is snapshotted. Friday evening regret is one <code class="mono">lps hook rollback</code> away.</p>
          </article>
          <aside class="hand note">yes, even on a Friday</aside>

          <article>
            <h2 class="display text-4xl"><span class="mark">↺</span> And around again.</h2>
            <p>Meanwhile the client added a menu item in wp-admin. That is WordPress, the live site moves on its own. The diff catches it, one pull brings it home, and the next Build starts from the real site.</p>
            <pre class="card">{`$ lps pull --env production
✓ menus/primary.json updated`}</pre>
          </article>
          <aside class="hand note">this arrow is why it's a loop, not a pipeline</aside>
        </div>
      </section>

      <!-- Editions: Full literally wraps Light -->
      <section id="editions" class="rule">
        <div class="wrap py-24">
          <h2 class="display max-w-3xl text-5xl">Start with your configuration. Add your code when you are ready.</h2>
          <div class="full mt-12">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <p class="display text-2xl">Loopress Full <span class="muted text-base">· your code, in Git, with conventions</span></p>
              <p class="mono small">free · loopress.dev</p>
            </div>
            <div class="mt-8 grid gap-8 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
              <div class="light">
                <p class="display text-2xl">Loopress Light</p>
                <p class="muted mt-1">your configuration, in Git</p>
                <p class="mono small mt-5">ACF · SEO · menus · options · block theme styles</p>
                <p class="mono small mt-5">free · Plugins → Add New</p>
              </div>
              <div>
                <p class="hand text-2xl">+ your code</p>
                <p class="mono small mt-3">hooks · API routes · apps · pages · Composer · plugin lockfile</p>
                <p class="small mt-6 muted">WordPress.org does not host plugins that deploy executable code, so Full ships from loopress.dev. Same plugin, code half switched on.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="rule">
        <div class="wrap flex flex-wrap items-center justify-between gap-6 py-20">
          <p class="display text-4xl">Open source, and yours to keep.</p>
          <code class="chip text-lg">$ npm i -g @loopress/cli</code>
        </div>
      </section>
    </main>

    <footer class="rule">
      <div class="wrap flex flex-wrap items-center justify-between gap-4 py-8 text-sm">
        <Logo class="h-5 w-5" />
        <span class="mono small">MPL-2.0 · docs · github</span>
      </div>
    </footer>
  </div>
</Layout>

<style>
  /* Hallmark · macrostructure: Long Document (notebook) · tone: warm craft · anchor hue: 200 (logo cyan) */
  .atelier {
    --paper: oklch(0.965 0.018 85);
    --paper-2: oklch(0.935 0.022 85);
    --ink: oklch(0.22 0.02 60);
    --muted: oklch(0.45 0.02 60);
    --rule: oklch(0.82 0.02 80);
    --accent: oklch(0.72 0.14 215);
    --accent-ink: oklch(0.48 0.12 220);
    --font-display: "Fraunces", Georgia, serif;
    --font-hand: "Caveat", cursive;
    --font-mono: "IBM Plex Mono", ui-monospace, monospace;
    --loop-line: var(--accent-ink);
    --loop-node: var(--paper);
    --loop-text: var(--ink);
    --logo-accent: var(--accent);
    background: var(--paper);
    color: var(--ink);
    min-height: 100vh;
    overflow-x: clip;
  }
  .wrap { margin-inline: auto; max-width: 72rem; padding-inline: 1.5rem; }
  .display { font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em; line-height: 1.02; font-style: normal; }
  .hand { font-family: var(--font-hand); color: var(--accent-ink); font-size: 1.35rem; line-height: 1.2; }
  .mono { font-family: var(--font-mono); }
  .muted { color: var(--muted); }
  .small { font-size: 0.875rem; }
  .mark { background: linear-gradient(transparent 62%, color-mix(in oklch, var(--accent) 45%, transparent) 62%); }
  .rule { border-top: 1px solid var(--rule); }
  nav a:hover, header a:hover { color: var(--accent-ink); }

  .chip { font-family: var(--font-mono); border: 1px solid var(--rule); background: var(--paper-2); padding: 0.6rem 1rem; border-radius: 0.375rem; }
  .btn { display: inline-flex; align-items: center; height: 2.75rem; padding-inline: 1.25rem; border-radius: 0.375rem; background: var(--ink); color: var(--paper); font-weight: 600; }
  .btn:hover { background: var(--accent-ink); }

  .notebook { display: grid; gap: 1rem 3rem; padding-block: 5rem; }
  @media (min-width: 1024px) { .notebook { grid-template-columns: minmax(0, 8fr) minmax(0, 3fr); } }
  .notebook article { padding-block: 2.5rem; max-width: 44rem; }
  .notebook article p { margin-top: 1rem; font-size: 1.125rem; line-height: 1.7; }
  .notebook .note { align-self: center; transform: rotate(-3deg); }
  .cards { display: grid; gap: 1.25rem; margin-top: 1.75rem; }
  @media (min-width: 768px) { .cards { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .card { margin-top: 1.5rem; background: var(--paper-2); border: 1px solid var(--rule); border-radius: 0.25rem; padding: 1rem 1.25rem; font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.7; overflow-x: auto; box-shadow: 0 1px 0 var(--rule), 0 8px 18px -12px oklch(0.3 0.03 60 / 0.35); }
  .cards .card { margin-top: 0; }
  .tilt { transform: rotate(0.8deg); }

  .full { border: 2px solid var(--ink); border-radius: 0.5rem; padding: 2rem; }
  .light { background: var(--paper-2); border: 1px dashed var(--accent-ink); border-radius: 0.375rem; padding: 1.5rem; }
</style>
