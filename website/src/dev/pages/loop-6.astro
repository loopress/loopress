---
// Prototype A6 "Brutal": heavy grotesk, thick borders, hard offset shadows, flat black and
// logo-cyan blocks, zero radius, visible grid. A dev tool made by devs. Throwaway, not linked.
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/site/Logo.astro";
import LoopDiagram from "@/dev/components/LoopDiagram.astro";

export const prerender = true;

const stages = [
  { n: "01", label: "Build", body: "Fields as JSON, hooks and routes as PHP classes. One repo.", cmd: "$EDITOR hooks/vat-notice.php" },
  { n: "02", label: "Review", body: "A diff with no posts, orders or users in it. Short enough for a PR.", cmd: "lps diff --env staging" },
  { n: "03", label: "Ship", body: "Staging, then production. Every push snapshotted, undo in one line.", cmd: "lps promote staging production" },
];
---

<Layout title="Loopress - Build, review and ship WordPress, in one loop">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@500;700&display=swap" />

  <div class="brutal">
    <header class="bar">
      <a href="#top" class="cell logo"><Logo class="h-7 w-7" /></a>
      <nav class="cell grow hidden md:flex">
        <a href="#stages">Loop</a><a href="#pull">Pull back</a><a href="#editions">Light / Full</a>
      </nav>
      <a href="https://github.com/loopress" class="cell invert">GitHub ↗</a>
    </header>

    <main id="top">
      <section class="hero">
        <div class="pitch">
          <h1>Build, review and ship WordPress, in one loop.</h1>
          <p class="lede">Model your content types, write hooks and APIs in modern PHP, review every change in a PR and ship it to every environment. Your content never moves.</p>
          <div class="ctas">
            <code class="box">$ npm i -g @loopress/cli</code>
            <a href="https://github.com/loopress" class="box accent">★ Star on GitHub</a>
          </div>
        </div>
        <figure class="diagram">
          <LoopDiagram square />
        </figure>
      </section>

      <section id="stages" class="stages">
        {stages.map((s) => (
          <article>
            <p class="num">{s.n}</p>
            <h2>{s.label}</h2>
            <p>{s.body}</p>
            <code>$ {s.cmd}</code>
          </article>
        ))}
      </section>

      <section id="pull" class="pull">
        <p class="big" aria-hidden="true">↺</p>
        <div>
          <h2>The client edited a menu in wp-admin. Pull it back.</h2>
          <p>The live site moves between releases. That is WordPress. The diff catches the drift, one pull brings it into the repo, the next Build starts from the real site.</p>
        </div>
        <pre class="term">{`$ lps diff --env production
~ menu  primary   1 item added on the site
$ lps pull --env production
✓ menus/primary.json updated`}</pre>
      </section>

      <section id="editions" class="editions">
        <h2>Full = Light + your code.</h2>
        <div class="full">
          <p class="tag">Loopress Full · free · loopress.dev</p>
          <div class="inner">
            <div class="light">
              <p class="tag">Loopress Light · free · WordPress.org</p>
              <p class="title">Your configuration, in Git.</p>
              <p class="list">ACF / SEO / menus / options / block theme styles</p>
            </div>
            <div class="plus">
              <p class="title">+ your code, with conventions.</p>
              <p class="list">hooks / API routes / apps / pages / Composer / plugin lockfile</p>
            </div>
          </div>
        </div>
        <p class="why">WordPress.org does not host plugins that deploy executable code. So Light lives in the directory, and Full is the same plugin with the code half switched on.</p>
      </section>

      <section class="install">
        <code>$ npm i -g @loopress/cli</code>
      </section>
    </main>

    <footer class="bar">
      <span class="cell"><Logo class="h-5 w-5" /></span>
      <span class="cell grow">MPL-2.0 · open source · no account needed</span>
      <a href="https://github.com/loopress" class="cell">github</a>
    </footer>
  </div>
</Layout>

<style>
  /* Hallmark · macrostructure: Bento slabs · tone: brutalist · anchor hue: 200 (logo cyan) */
  .brutal {
    --paper: oklch(0.985 0 0);
    --ink: oklch(0.13 0 0);
    --accent: oklch(0.75 0.14 215);
    --b: 3px solid var(--ink);
    --shadow: 6px 6px 0 var(--ink);
    --font-display: "Space Grotesk", system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
    --loop-line: var(--ink);
    --loop-node: var(--accent);
    --loop-text: var(--ink);
    --logo-accent: var(--accent);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-display);
    overflow-x: clip;
  }
  h1, h2 { font-weight: 700; letter-spacing: -0.03em; line-height: 0.95; overflow-wrap: anywhere; min-width: 0; }

  .bar { display: flex; border-bottom: var(--b); font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; }
  footer.bar { border-top: var(--b); border-bottom: 0; }
  .cell { display: flex; align-items: center; gap: 1.5rem; padding: 1rem 1.25rem; border-right: var(--b); white-space: nowrap; }
  .cell:last-child { border-right: 0; }
  .grow { flex: 1; }
  .invert { background: var(--ink); color: var(--paper); }
  .invert:hover, nav a:hover { color: var(--accent); }

  .hero { display: grid; border-bottom: var(--b); }
  @media (min-width: 1024px) { .hero { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
  .pitch { padding: 4rem 1.5rem; }
  @media (min-width: 1024px) { .pitch { padding: 5rem 3rem; border-right: var(--b); } }
  h1 { font-size: clamp(3rem, 8vw, 6.5rem); text-transform: uppercase; }
  .lede { margin-top: 2rem; max-width: 36rem; font-size: 1.15rem; line-height: 1.55; font-weight: 500; }
  .ctas { margin-top: 2.5rem; display: flex; flex-wrap: wrap; gap: 1rem; }
  .box { border: var(--b); box-shadow: var(--shadow); padding: 0.75rem 1.1rem; font-family: var(--font-mono); font-weight: 700; background: var(--paper); white-space: nowrap; transition: transform 120ms, box-shadow 120ms; }
  .box.accent { background: var(--accent); }
  a.box:hover { transform: translate(3px, 3px); box-shadow: 3px 3px 0 var(--ink); }
  .diagram { padding: 2.5rem; display: grid; place-items: center; background-size: 40px 40px; }
  .diagram { --grid: color-mix(in oklch, var(--ink) 10%, transparent); background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px); }
  .diagram :global(svg) { max-width: 26rem; }

  .stages { display: grid; border-bottom: var(--b); }
  @media (min-width: 768px) { .stages { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .stages article { padding: 2.5rem 1.5rem; border-bottom: var(--b); }
  @media (min-width: 768px) { .stages article { border-bottom: 0; border-right: var(--b); } .stages article:last-child { border-right: 0; } }
  .num { font-family: var(--font-mono); font-size: 5rem; font-weight: 700; line-height: 1; color: var(--accent); -webkit-text-stroke: 2px var(--ink); }
  .stages h2 { margin-top: 1rem; font-size: 2.75rem; text-transform: uppercase; }
  .stages p:not(.num) { margin-top: 0.75rem; font-weight: 500; line-height: 1.5; }
  .stages code { display: block; margin-top: 1.5rem; padding: 0.6rem 0.8rem; background: var(--ink); color: var(--paper); font-family: var(--font-mono); font-size: 0.78rem; overflow-x: auto; white-space: nowrap; }

  .pull { display: grid; gap: 2rem; align-items: center; padding: 3.5rem 1.5rem; background: var(--accent); border-bottom: var(--b); }
  @media (min-width: 1024px) { .pull { grid-template-columns: auto minmax(0, 5fr) minmax(0, 5fr); padding: 4rem 3rem; } }
  .big { font-size: 9rem; line-height: 0.8; font-weight: 700; }
  .pull h2 { font-size: 2.5rem; }
  .pull p { margin-top: 1rem; font-weight: 500; line-height: 1.5; }
  .term { background: var(--ink); color: var(--paper); border: var(--b); box-shadow: var(--shadow); padding: 1.25rem; font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.7; overflow-x: auto; }

  .editions { padding: 5rem 1.5rem; border-bottom: var(--b); }
  @media (min-width: 1024px) { .editions { padding: 6rem 3rem; } }
  .editions h2 { font-size: clamp(2.5rem, 6vw, 5rem); text-transform: uppercase; }
  .full { margin-top: 3rem; background: var(--ink); color: var(--paper); padding: 1.5rem; box-shadow: 10px 10px 0 var(--accent); }
  .tag { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
  .inner { margin-top: 1.5rem; display: grid; gap: 1.5rem; }
  @media (min-width: 768px) { .inner { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }
  .light { background: var(--accent); color: var(--ink); border: var(--b); padding: 1.5rem; }
  .title { margin-top: 0.5rem; font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.05; }
  .list { margin-top: 1rem; font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.6; }
  .plus { padding: 1.5rem 0.5rem; }
  .why { margin-top: 2.5rem; max-width: 40rem; font-weight: 500; line-height: 1.5; }

  .install { padding: 4rem 1.5rem; background: var(--ink); color: var(--paper); overflow-x: auto; }
  .install code { font-family: var(--font-mono); font-weight: 700; font-size: clamp(1.5rem, 5vw, 4rem); white-space: nowrap; }
</style>
