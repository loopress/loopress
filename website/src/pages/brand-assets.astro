---
// Brand assets and trademark policy, plus the mark itself on light and dark.
import DocPage from "@/components/site/DocPage.astro";
import Logo from "@/components/site/Logo.astro";
import licenseText from "@loopress/assets/LICENSE?raw";

export const prerender = true;
---

<DocPage title="Brand assets - Loopress" description="Trademark and brand asset usage policy for the Loopress name and logo. How to reference Loopress in your projects and content." kicker="brand assets" heading="The Loopress mark." lede="An open hexagon: a loop, with an opening. Here is how to use it." wide>
  <div class="marks">
    <div class="mark light"><Logo class="h-20 w-20" wordmark={false} /></div>
    <div class="mark dark"><Logo class="h-20 w-20" wordmark={false} /></div>
  </div>

  <h2>Trademark license</h2>
  <pre>{licenseText}</pre>
  <p>For a use not covered above, <a href="/contact">ask first</a>.</p>
</DocPage>

<style>
  .marks { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); margin-bottom: 1rem; }
  .mark { display: grid; place-items: center; aspect-ratio: 16 / 9; border-radius: 0.75rem; }
  .light { background: white; color: oklch(0.22 0.05 255); border: 1px solid color-mix(in oklch, currentColor 15%, transparent); }
  .dark { background: oklch(0.22 0.05 255); color: oklch(0.975 0.008 95); }
</style>
