---
import Layout from "@/layouts/Layout.astro";
import { Nav } from "@/components/landing/Nav";
import { Hero } from "@/components/landing/Hero";
import { Demo } from "@/components/landing/Demo";
import { Problem } from "@/components/landing/Problem";
import { Solution } from "@/components/landing/Solution";
import { Features } from "@/components/landing/Features";
import { Security } from "@/components/landing/Security";
import { Integrations } from "@/components/landing/Integrations";
import { Agencies } from "@/components/landing/Agencies";
import { FinalCTA } from "@/components/landing/FinalCTA";
import { Footer } from "@/components/landing/Footer";

export const prerender = true;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Loopress",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Web",
  description:
    "The Git layer for WordPress. A versioned file describes the desired state of a site's code and critical config, Loopress diffs it against the live site and reconciles. It never touches the content.",
  url: "https://loopress.dev",
  author: { "@id": "https://loopress.dev/#organization" },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    description: "Free during alpha",
  },
};
---

<Layout
  title="Loopress - The Git layer for WordPress"
  description="Clone, edit and push the code and critical config of your existing WordPress sites. A versioned file describes the desired state, Loopress reconciles it with the live site. Never the content. Join the alpha."
  canonical="https://loopress.dev/"
  ogTitle="Loopress - The Git layer for WordPress"
  ogDescription="A real Git workflow, clone, edit, push, over the theme and critical config of your existing WordPress sites. No rewrite, no risk to the content."
  structuredData={structuredData}
>
  <div class="min-h-screen bg-background text-foreground">
    <Nav client:load />
    <main>
      <Hero />
      <Demo client:visible />
      <Problem />
      <Solution />
      <Features />
      <Security />
      <Integrations />
      <Agencies />
      <FinalCTA client:load />
    </main>
    <Footer />
  </div>
</Layout>
