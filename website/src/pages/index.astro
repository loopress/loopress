---
// Home. The loop is the logo: the dark C is your repo (Build, Review), the cyan chevron the live
// site, Ship and Pull back are the two joints between them. Below, what's in Git, a week of five
// client sites as tabs (radio inputs + CSS, no JS), one scenario per kind of WordPress project,
// and the Light / Full toggle. Earlier iterations live under /dev (astro dev only).
// Every command, flag, path and behaviour shown here was checked in cli/ and the docs.
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/site/Logo.astro";
import Editions from "@/components/site/Editions.astro";
import Footer from "@/components/site/Footer.astro";

export const prerender = true;

const description =
  "Model your content types, write hooks and APIs in modern PHP, review every change in a PR and ship it to every environment. When the live site changes, pull it back. Your content never moves.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Loopress",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Web",
  description,
  url: "https://loopress.dev",
  author: { "@id": "https://loopress.dev/#organization" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

// Flat-top hexagon, same orientation and proportions as the logo.
const hexPoints = (cx: number, cy: number, r: number) =>
  [0, 60, 120, 180, 240, 300].map((a) => {
    const t = (a * Math.PI) / 180;
    return [+(cx + r * Math.cos(t)).toFixed(1), +(cy + r * Math.sin(t)).toFixed(1)] as const;
  });

// Loop vertices: R, BR, BL, L, TL, TR (angles 0..300, y grows downward).
const [R, BR, BL, L, TL, TR] = hexPoints(200, 200, 130);
const repoSide = `M${BR} L${BL} L${L} L${TL} L${TR}`; // the dark "C" of the logo: your repo
const siteSide = `M${TR} L${R} L${BR}`; // the cyan chevron: the live site
const travel = `M${L} L${TL} L${TR} L${R} L${BR} L${BL} Z`; // clockwise, from Build

// Each stage is a vertex. Ship and Pull back are the two joints between the logo's pieces.
const stageAt: Record<string, readonly [number, number]> = { Build: L, Review: TL, Ship: TR, "Pull back": BR };

const sites = ["bakery", "law-firm", "shop", "school", "studio"];

const tree = [
  ["acf/", "", ""],
  ["│   └── group_product_delivery.json", "field groups", "light"],
  ["├── seo/  menus/  options/  theme/", "configuration", "light"],
  ["├── hooks/", "", ""],
  ["│   └── vat-notice.php", "one class per file", "full"],
  ["├── api/  apps/  pages/", "code", "full"],
  ["├── composer.json", "plugins and themes, locked", "full"],
  ["└── loopress.json", "environments", ""],
];

const tracked = [
  ["ACF field groups", "Light"],
  ["SEO, menus, options", "Light"],
  ["Block theme styles", "Light"],
  ["Hooks, API routes", "Full"],
  ["Apps, pages", "Full"],
  ["Plugin lockfile", "Full"],
  ["Composer", "Full"],
];

type Moment = {
  stage: "Build" | "Review" | "Ship" | "Pull back";
  tag?: string;
  when: string;
  site: string;
  ask: string;
  body: string;
  code: string;
  note: string;
};

// One scenario per site, each one around the whole loop.
const scenarios: Record<string, Moment[]> = {
  bakery: [
    {
      stage: "Build", when: "Monday 9:10", site: "bakery",
      ask: "“Can we show a delivery date, and say prices include VAT?”",
      body: "One request, two kinds of change. The delivery date is an ACF field on the product, the notice is a WooCommerce hook. Both land as files in the same repo, next to each other.",
      code: `// hooks/vat-notice.php
use Loopress\\Hooks\\Attribute\\Filter;

class VatNotice
{
    #[Filter('woocommerce_get_price_html')]
    public function notice(string $html): string
    {
        return $html . ' <small>incl. VAT</small>';
    }
}`,
      note: "no add_filter, no functions.php. one class per file.",
    },
    {
      stage: "Review", when: "Monday 11:30", site: "bakery",
      ask: "Open the PR, let CI look first.",
      body: "The diff is only configuration and code. Products, orders and customers are never in it, so it stays short enough to actually read.",
      code: `$ lps diff --env staging`,
      note: "exit 1 on drift, so CI says no before you do.",
    },
    {
      stage: "Ship", when: "Tuesday 14:00", site: "bakery",
      ask: "The client approved staging.",
      body: "Push what you reviewed, then promote staging to production. Every push takes a snapshot first.",
      code: `$ lps push --env staging
$ lps promote staging production`,
      note: "same two commands on every site.",
    },
    {
      stage: "Pull back", when: "Wednesday 15:40", site: "bakery",
      ask: "The shop manager renamed the delivery date field in wp-admin.",
      body: "Fair enough, it's their shop. The diff shows the field group moved on the live site, one pull brings the new label into the repo before anyone builds on the old one.",
      code: `$ lps acf diff --env production
$ lps acf pull --env production --type field-groups
$ git commit -am "chore: sync delivery date label"`,
      note: "the repo follows the site, not the other way round.",
    },
    {
      stage: "Ship", tag: "Ship · safety net", when: "Friday 17:48", site: "bakery",
      ask: "“The price looks weird on the cart page.”",
      body: "Roll the hook back to the snapshot taken before Tuesday's push. Loopress first checks nobody changed it on the site since, so the undo can't clobber someone else's edit.",
      code: `$ lps hook rollback --env production`,
      note: "undo now, the proper fix waits for Monday.",
    },
  ],
  "law-firm": [
    {
      stage: "Build", when: "Monday 10:00", site: "law-firm",
      ask: "“We need an intake form, and practice area pages with the same fields.”",
      body: "Build the WPForms form and the ACF field group on staging, where you can click through them. Then pull both down: they are JSON files in the repo from now on.",
      code: `$ lps form pull --env staging
$ lps acf pull --env staging --type field-groups
$ git status --short
?? acf/field-groups/group_practice_area.json
?? forms/14-client-intake.json`,
      note: "built in the admin, kept in Git.",
    },
    {
      stage: "Review", when: "Tuesday 9:30", site: "law-firm",
      ask: "“Can the partners check the form before it goes live?”",
      body: "They read the PR, not a screenshot. The diff against production shows the new form and the new field group, nothing else.",
      code: `$ lps diff --env production --only form --only acf`,
      note: "one question in the PR instead of three calls.",
    },
    {
      stage: "Ship", when: "Tuesday 15:00", site: "law-firm",
      ask: "Approved, the intake goes to the new partner.",
      body: "A form push leaves notification settings alone by default, so a stray push can't redirect where submissions go. Here the new recipient is the point, so you say so.",
      code: `$ lps acf push --env production
$ lps form push --env production --allow-notifications`,
      note: "recipients are validated, the sender stays on the site's own domain.",
    },
    {
      stage: "Pull back", when: "Wednesday 10:05", site: "law-firm",
      ask: "The client added a menu item in wp-admin, on their own.",
      body: "That is WordPress, the live site moves between your releases. The diff shows the drift, one pull brings it back into the repo, and the next Build starts from the real site.",
      code: `$ lps diff --env production
$ lps pull --env production
$ git commit -am "chore: sync client menu edit"`,
      note: "this is why it's a loop and not a pipeline.",
    },
  ],
  shop: [
    {
      stage: "Build", when: "Monday 14:20", site: "shop",
      ask: "“WooCommerce wants to update itself again.”",
      body: "Plugins are a lockfile in loopress.json. Bump the pin in the repo instead of clicking update on the site, and every environment installs the exact same version.",
      code: `$ lps plugin add woocommerce --version 9.5.0
$ git diff loopress.json
-    "woocommerce": "9.4.2",
+    "woocommerce": "9.5.0",`,
      note: "the update is a one-line diff.",
    },
    {
      stage: "Review", when: "Monday 14:45", site: "shop",
      ask: "CI checks the new set before anyone merges.",
      body: "The audit checks every pinned version against a vulnerability database and WordPress.org's health signals. Status shows how far staging is from the lockfile.",
      code: `$ lps plugin audit
$ lps plugin status --env staging`,
      note: "the audit exits non-zero on a known vulnerability.",
    },
    {
      stage: "Ship", when: "Wednesday 9:00", site: "shop",
      ask: "Staging ran the new version for a day, all good.",
      body: "Install the lockfile on staging, then promote it: production gets the versions staging actually ran, installed by Composer on the site, no SSH.",
      code: `$ lps plugin push --env staging
$ lps promote staging production`,
      note: "same plugins, same versions, everywhere.",
    },
    {
      stage: "Pull back", when: "Thursday 11:15", site: "shop",
      ask: "Someone installed a plugin by hand on production.",
      body: "Status spots it. Keep it, and a pull pins it into the lockfile at the version running on the site. Or don't, and the next push with --prune deactivates it.",
      code: `$ lps plugin status --env production
Active but untracked: hello-dolly
$ lps plugin pull --env production`,
      note: "keep it or prune it, never leave it untracked.",
    },
    {
      stage: "Ship", tag: "Ship · safety net", when: "Friday 16:30", site: "shop",
      ask: "“Checkout feels slower since Wednesday.”",
      body: "Pin the previous version back. Downgrades need --force, because the old files come back but the database migrations the new version ran don't.",
      code: `$ lps plugin add woocommerce --version 9.4.2
$ lps plugin push --env production --force`,
      note: "read the changelog before you downgrade.",
    },
  ],
  school: [
    {
      stage: "Build", when: "Monday 16:00", site: "school",
      ask: "“Parents want their kid's timetable, on the site and on their phone.”",
      body: "A custom REST route, written as a plain class. The file path is the route, the bracketed segment is a parameter, and the attribute opens it to visitors.",
      code: `// api/timetable/[class_id].php
use Loopress\\Api\\Attribute\\Permission;

class Timetable
{
    #[Permission(public: true)]
    public function get(WP_REST_Request $request): array
    {
        $class = $request->get_param('class_id');
        return get_option("timetable_{$class}", []);
    }
}`,
      note: "answers at /wp-json/loopress-api/v1/timetable/6b.",
    },
    {
      stage: "Review", when: "Tuesday 10:00", site: "school",
      ask: "The timetable page is a small Vue app, reviewed like the rest.",
      body: "The route file and the app's source sit in the same PR. CI builds the app and diffs the route against staging, so the reviewer sees both halves of the feature.",
      code: `$ npm --prefix apps/timetable run build
$ lps diff --env staging --only api`,
      note: "front and back in one review.",
    },
    {
      stage: "Ship", when: "Wednesday 13:00", site: "school",
      ask: "Ready for the parents' evening.",
      body: "Push the route, then the app. The app mounts in any page with a shortcode, the office can place it themselves.",
      code: `$ lps api push --env production
$ lps app push timetable --env production

[loopress_app name="timetable"]`,
      note: "apps have their own build, so they ship with their own command.",
    },
    {
      stage: "Pull back", when: "Thursday 9:20", site: "school",
      ask: "A contractor hot-fixed the route on the server, over SFTP.",
      body: "The fix works, but only on production. The diff shows it, one pull puts it in the repo, so the next push doesn't quietly undo it.",
      code: `$ lps api diff --env production
$ lps api pull --env production
$ git commit -am "fix: keep the timetable hotfix"`,
      note: "the hotfix lives in Git now, not just on the server.",
    },
  ],
  studio: [
    {
      stage: "Build", when: "Monday 11:00", site: "studio",
      ask: "“New brand: a new accent color, and no sidebar on blog posts.”",
      body: "Global Styles are one JSON file, the Site Editor's Styles screen in text. Templates are block markup files, the same HTML the Site Editor saves.",
      code: `// theme/twentytwentyfive-global-styles.json
{
  "settings": {
    "color": {
      "palette": {
        "custom": [
          {"slug": "brand", "name": "Brand", "color": "#ff5a36"}
        ]
      }
    }
  }
}`,
      note: "plus templates/single.html, without the sidebar.",
    },
    {
      stage: "Review", when: "Tuesday 11:00", site: "studio",
      ask: "The client's designer reviews the PR.",
      body: "The diff covers the styles file and the template, and it includes edits someone made in the Site Editor on staging, so nothing gets overwritten by surprise.",
      code: `$ lps diff --env staging`,
      note: "a color change reads as a color change.",
    },
    {
      stage: "Ship", when: "Wednesday 17:00", site: "studio",
      ask: "Signed off.",
      body: "Theme push sends templates and parts as a child theme of the active one, then the Global Styles. The parent theme stays untouched and keeps its updates.",
      code: `$ lps theme push --env production`,
      note: "the child theme is activated once, by you, never by Loopress.",
    },
    {
      stage: "Pull back", when: "Thursday 14:30", site: "studio",
      ask: "The designer nudged the heading size in the Site Editor.",
      body: "Their tweak is good, keep it. The diff shows it, one pull writes it into the styles file, and the next push doesn't undo it.",
      code: `$ lps diff --env production
$ lps theme pull --env production`,
      note: "templates have no pull: Site Editor edits show in the diff, you copy them over.",
    },
  ],
};

---

<Layout
  title="Loopress - Build, review and ship WordPress, in one loop"
  description={description}
  canonical="https://loopress.dev/"
  ogTitle="Loopress - Build, review and ship WordPress, in one loop"
  ogDescription={description}
  structuredData={structuredData}
>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=JetBrains+Mono:wght@500&display=swap" />

  <div class="page">
    <header class="wrap flex items-center justify-between gap-4 py-6">
      <a href="#top" class="text-lg font-extrabold"><Logo class="h-9 w-9" /></a>
      <nav class="topnav hidden text-sm font-medium md:flex">
        <a href="#scope">What's in Git</a><a href="#week">A week in the loop</a><a href="#editions">Light & Full</a><a href="https://docs.loopress.dev">Docs</a>
      </nav>
      <a href="https://github.com/loopress" class="mono text-xs">★ GitHub</a>
    </header>

    <main id="top">
      <!-- Hero: the loop IS the logo -->
      <section class="wrap hero">
        <div>
          <h1>Build, review and ship WordPress, in one <span class="hl">loop.</span></h1>
          <p class="lede">
            Model your content types, write hooks and APIs in modern PHP, review every change in a
            PR and ship it to every environment. When the live site changes, pull it back and go
            around again. Your content never moves.
          </p>
          <div class="ctas">
            <code class="chip">$ npm i -g @loopress/cli</code>
            <a href="https://docs.loopress.dev/getting-started/" class="btn">Get started</a>
          </div>
          <p class="mono hint">then <code>lps project config</code> connects your site and installs the plugin for you.</p>
        </div>

        <figure>
          <svg viewBox="-110 10 660 390" class="w-full" role="img" aria-label="The Loopress hexagon as a loop. The dark side is your repo, with Build and Review. The cyan side is your live site. Ship crosses from repo to site at the top, Pull back crosses from site to repo at the bottom.">
            <path d={repoSide} class="seg-repo" />
            <path d={siteSide} class="seg-site" />
            <circle r="9" class="dot"><animateMotion dur="8s" repeatCount="indefinite" path={travel} /></circle>
            <circle cx={L[0]} cy={L[1]} r="15" class="node" />
            <circle cx={TL[0]} cy={TL[1]} r="15" class="node" />
            <circle cx={TR[0]} cy={TR[1]} r="15" class="node node-cross" />
            <circle cx={BR[0]} cy={BR[1]} r="15" class="node node-cross" />
            <text x={TL[0]} y={TL[1] - 30} text-anchor="middle" class="lbl">Review</text>
            <text x={TR[0]} y={TR[1] - 30} text-anchor="middle" class="lbl">Ship →</text>
            <text x={L[0] - 34} y={L[1] + 7} text-anchor="end" class="lbl">Build</text>
            <text x={BR[0]} y={BR[1] + 44} text-anchor="middle" class="lbl">← Pull back</text>
            <text x={BL[0]} y={BL[1] + 44} text-anchor="middle" class="lbl">your repo</text>
            <text x={BL[0]} y={BL[1] + 64} text-anchor="middle" class="sub">config + code</text>
            <text x={R[0] + 34} y={R[1] - 4} class="lbl lbl-site">your live site</text>
            <text x={R[0] + 34} y={R[1] + 18} class="sub">wp-admin edits happen here</text>
            <text x="200" y="205" text-anchor="middle" class="sub">your content never moves</text>
          </svg>
          <figcaption class="aside text-center">the whole idea, on one hexagon.</figcaption>
        </figure>
      </section>

      <!-- Scope: what "in Git" means, concretely -->
      <section id="scope" class="scope">
        <div class="wrap py-24">
          <h2 class="max-w-3xl">Everything but the content, in Git.</h2>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed">
            Your repo holds how the site is built and behaves. What your client writes stays in
            WordPress, where it belongs.
          </p>
          <div class="scope-grid">
            <pre class="tree"><span class="dim">$ tree client-site</span>{"\n"}client-site/{"\n"}├── {tree.map(([line, comment, kind]) => (
              <>{line}{comment && <span class={`cmt ${kind}`}>{"  "}# {comment}</span>}{"\n"}</>
            ))}</pre>
            <div>
              <table class="tracked">
                <tbody>
                  {tracked.map(([what, edition]) => (
                    <tr>
                      <td>{what}</td>
                      <td class={`ed ${edition === "Full" ? "ed-full" : "ed-light"}`}>{edition}</td>
                    </tr>
                  ))}
                  <tr class="never">
                    <td>Posts, pages content, orders, users, media</td>
                    <td class="ed">never</td>
                  </tr>
                </tbody>
              </table>
              <p class="aside mt-5"><code class="mono">lps diff</code> exits 0 in sync, 1 on drift. that's your CI gate.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- The week: stages as moments, marked by the hexagon segment they light -->
      <section id="week" class="week">
        <div class="wrap py-24">
          <h2 class="max-w-3xl">One week, five client sites, the same loop every time.</h2>
          <p class="body mt-6">Each site used to have its own ritual: FTP here, a plugin upload there, a note in a doc somewhere. Now they all go around the same loop.</p>
          <!-- Site picker: radio inputs + CSS (:has), no JS. Arrow keys move between sites. -->
          <fieldset class="sites mt-8">
            <legend class="sr-only">Client site</legend>
            {sites.map((s, i) => (
              <label>
                <input type="radio" name="week-site" id={`site-${s}`} value={s} checked={i === 0} class="sr-only" />
                <span>{s}</span>
              </label>
            ))}
          </fieldset>
          {sites.map((id) => (
            <ol class="timeline panel mt-16" id={`week-${id}`}>
              {scenarios[id].map((e) => (
                <li class={e.stage === "Pull back" ? "is-pull" : ""}>
                  <svg viewBox="0 10 400 380" class="minihex" aria-hidden="true">
                    <path d={repoSide} class="mini-repo" />
                    <path d={siteSide} class="mini-site" />
                    <circle cx={stageAt[e.stage][0]} cy={stageAt[e.stage][1]} r="54" class="mini-on" />
                  </svg>
                  <div>
                    <p class="mono meta"><span class="stage">{e.tag ?? e.stage}</span> · {e.when} · {e.site}</p>
                    <h3>{e.ask}</h3>
                    <p class="body">{e.body}</p>
                  </div>
                  <div class="side">
                    <pre>{e.code}</pre>
                    <p class="aside">{e.note}</p>
                  </div>
                </li>
              ))}
            </ol>
          ))}
        </div>
      </section>

      <!-- Editions: one plugin, a switch turns the code half on (Editions toggle variant). -->
      <section id="editions" class="wrap editions">
        <div>
          <h2><span class="h-light">Config first.</span><br /><span class="h-full">Code later.</span></h2>
          <p class="free mt-5"><span>Both free</span><span>Both open source, GPL</span></p>
          <p class="mt-6 text-lg leading-relaxed">
            <strong>Light</strong> puts your configuration in Git. It is on WordPress.org.
          </p>
          <p class="mt-4 text-lg leading-relaxed">
            <strong>Full</strong> is the same plugin with the code half switched on, with
            conventions instead of <code class="mono">functions.php</code>.{" "}
            <code class="mono">lps project config</code> installs it for you.
          </p>
          <p class="aside mt-6">WordPress.org doesn't host plugins that deploy code, that's the whole reason there are two. <a href="https://docs.loopress.dev/blog/loopress-light-on-wordpress-org/" class="underline">The full story</a>.</p>
        </div>
        <Editions variant="toggle" />
      </section>

      <section class="close">
        <div class="wrap py-20">
          <h2>Open source, and yours to keep.</h2>
          <p class="mono install">$ npm i -g @loopress/cli<span class="caret" aria-hidden="true">_</span></p>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a href="https://docs.loopress.dev/getting-started/" class="btn btn-invert">Get started</a>
            <a href="https://github.com/loopress" class="mono text-sm underline">★ Star on GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  /* Hallmark · macrostructure: Brand-led loop + scope + timeline · tone: graphic, warm-technical · anchor hue: 215 (logo cyan) */
  .page {
    --paper: oklch(0.975 0.008 95);
    --paper-2: oklch(0.94 0.012 95);
    --navy: oklch(0.22 0.05 255);
    --cyan: oklch(0.76 0.14 215);
    --cyan-ink: oklch(0.5 0.12 225);
    --cyan-soft: color-mix(in oklch, var(--cyan) 22%, white);
    --yellow: oklch(0.88 0.16 95);
    --violet: oklch(0.55 0.18 290);
    --font-display: "Bricolage Grotesque", system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
    --logo-accent: var(--cyan);
    background: var(--paper);
    color: var(--navy);
    font-family: var(--font-display);
    overflow-x: clip;
  }
  .wrap { margin-inline: auto; max-width: 72rem; padding-inline: 1.5rem; }
  .mono { font-family: var(--font-mono); }
  a:hover { color: var(--cyan-ink); }
  .topnav { gap: 1.75rem; }
  h1, h2, h3 { font-weight: 800; letter-spacing: -0.035em; line-height: 1; overflow-wrap: anywhere; min-width: 0; }
  h1 { font-size: clamp(2.6rem, 5.5vw, 4.6rem); }
  h2 { font-size: clamp(2rem, 4vw, 3.25rem); }
  h3 { font-size: 1.6rem; letter-spacing: -0.02em; line-height: 1.15; }
  .hl { background: var(--yellow); padding-inline: 0.12em; box-decoration-break: clone; }
  .aside { font-weight: 500; color: var(--cyan-ink); }
  .aside::before { content: "// "; font-family: var(--font-mono); opacity: 0.7; }

  /* Hero */
  .hero { display: grid; gap: 2.5rem; padding-block: 2rem 6rem; align-items: center; }
  @media (min-width: 1024px) { .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .lede { margin-top: 1.75rem; max-width: 34rem; font-size: 1.15rem; line-height: 1.6; }
  .ctas { margin-top: 2.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .hint { margin-top: 1rem; font-size: 0.75rem; opacity: 0.7; }
  .chip { font-family: var(--font-mono); border: 2px solid var(--navy); padding: 0.6rem 1rem; border-radius: 0.5rem; background: var(--paper); }
  .btn { display: inline-flex; align-items: center; height: 2.9rem; padding-inline: 1.4rem; border-radius: 0.5rem; background: var(--navy); color: var(--paper); font-weight: 800; }
