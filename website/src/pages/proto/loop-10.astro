---
// Prototype A10: the best of loop..loop-9, week and readme, mixed.
// - loop-9: the loop drawn as the logo's hexagon, the week told as moments with mini-hexagon
//   markers, plain-text `//` dev voice, onboarding line under the CTA.
// - readme: the "what is tracked" table (Light / Full / never).
// - loop-7: `tree` of a real project, so you see what "in Git" looks like.
// - week: the same fix on five sites with a for loop, the site chips.
// - loop: the "every site had its own ritual" pain, Friday 17:48 rollback as Ship's safety net,
//   "Open source, and yours to keep".
// - loop-6/8: "Full = Light + your code", nested hexagons. loop-4/7: giant install line + caret.
// Every command, flag, path and behaviour shown here was checked in cli/ and the docs.
// Throwaway, not linked.
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/proto/Logo.astro";

export const prerender = true;

// Flat-top hexagon, same orientation and proportions as the logo.
const hexPoints = (cx: number, cy: number, r: number) =>
  [0, 60, 120, 180, 240, 300].map((a) => {
    const t = (a * Math.PI) / 180;
    return [+(cx + r * Math.cos(t)).toFixed(1), +(cy + r * Math.sin(t)).toFixed(1)] as const;
  });

// Loop vertices: R, BR, BL, L, TL, TR (angles 0..300, y grows downward).
const [R, BR, BL, L, TL, TR] = hexPoints(200, 200, 130);
const repoSide = `M${BR} L${BL} L${L} L${TL} L${TR}`; // the dark "C" of the logo
const siteSide = `M${TR} L${R} L${BR}`; // the cyan chevron
const pullBack = `M${BR} L${BL} L${L}`; // dashed marking on top of the C's bottom
const outline = `M${L} L${TL} L${TR} L${R} L${BR} L${BL} Z`;

// Each stage owns one segment of the hexagon, together they cover it exactly.
const segment: Record<string, string> = {
  Build: `M${L} L${TL}`,
  Review: `M${TL} L${TR}`,
  Ship: `M${TR} L${R} L${BR}`,
  "Pull back": `M${BR} L${BL} L${L}`,
};

const sites = ["bakery", "law-firm", "shop", "school", "studio"];

const tree = [
  ["acf/", "", ""],
  ["│   └── group_product_delivery.json", "field groups", "light"],
  ["├── seo/  menus/  options/  theme/", "configuration", "light"],
  ["├── hooks/", "", ""],
  ["│   └── vat-notice.php", "one class per file", "full"],
  ["├── api/  apps/  pages/  snippets/", "code", "full"],
  ["├── composer.json", "plugins and themes, locked", "full"],
  ["└── loopress.json", "environments", ""],
];

const tracked = [
  ["ACF field groups", "Light"],
  ["SEO, menus, options", "Light"],
  ["Block theme styles", "Light"],
  ["Hooks, API routes", "Full"],
  ["Apps, pages, snippets", "Full"],
  ["Composer, plugin lockfile", "Full"],
];

type Moment = {
  stage: "Build" | "Review" | "Ship" | "Pull back";
  tag?: string;
  when: string;
  site: string;
  ask: string;
  body: string;
  code: string;
  note: string;
};

const week: Moment[] = [
  {
    stage: "Build", when: "Monday 9:10", site: "bakery",
    ask: "“Can we show a delivery date, and say prices include VAT?”",
    body: "One request, two kinds of change. The field is configuration, the notice is code. Both land as files in the same repo, next to each other.",
    code: `// hooks/vat-notice.php
use Loopress\\Hooks\\Attribute\\Filter;

class VatNotice
{
    #[Filter('woocommerce_get_price_html')]
    public function notice(string $html): string
    {
        return $html . ' <small>incl. VAT</small>';
    }
}`,
    note: "no add_filter, no functions.php. one class per file.",
  },
  {
    stage: "Review", when: "Monday 11:30", site: "bakery",
    ask: "Open the PR, let CI look first.",
    body: "The diff is only configuration and code. Posts, orders and users are never in it, so it stays short enough to actually read.",
    code: `$ lps diff --env staging`,
    note: "exit 1 on drift, so CI says no before you do.",
  },
  {
    stage: "Ship", when: "Tuesday 14:00", site: "bakery",
    ask: "The client approved staging.",
    body: "Push what you reviewed, then promote staging to production. Every push takes a snapshot first.",
    code: `$ lps push --env staging
$ lps promote staging production`,
    note: "same two commands on every site.",
  },
  {
    stage: "Pull back", when: "Wednesday 10:05", site: "law-firm",
    ask: "The client added a menu item in wp-admin, on their own.",
    body: "That is WordPress, the live site moves between your releases. The diff shows the drift, one pull brings it back into the repo, and the next Build starts from the real site.",
    code: `$ lps diff --env production
$ lps pull --env production
$ git commit -am "chore: sync client menu edit"`,
    note: "this is why it's a loop and not a pipeline.",
  },
  {
    stage: "Ship", when: "Thursday 16:20", site: "all five",
    ask: "The same SEO fix, on every site.",
    body: "Each site used to have its own ritual: FTP here, a plugin upload there, a note in a doc somewhere. Now they all ship the same way.",
    code: `$ for s in ${sites.join(" ")}; do
    (cd $s && lps seo push --env production)
  done`,
    note: "five sites, one for loop.",
  },
  {
    stage: "Ship", tag: "Ship · safety net", when: "Friday 17:48", site: "bakery",
    ask: "“The price looks weird on the cart page.”",
    body: "Roll the hook back to the snapshot taken before Tuesday's push. Loopress first checks nobody changed it on the site since, so the undo can't clobber someone else's edit.",
    code: `$ lps hook rollback --env production`,
    note: "undo now, the proper fix waits for Monday.",
  },
];
---

<Layout title="Loopress - Build, review and ship WordPress, in one loop">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=JetBrains+Mono:wght@500&display=swap" />

  <div class="page">
    <header class="wrap flex items-center justify-between gap-4 py-6">
      <a href="#top" class="text-lg font-extrabold"><Logo class="h-9 w-9" /></a>
      <nav class="topnav hidden text-sm font-medium md:flex">
        <a href="#scope">What's in Git</a><a href="#week">A week in the loop</a><a href="#editions">Light & Full</a><a href="/docs">Docs</a>
      </nav>
      <a href="https://github.com/loopress" class="mono text-xs">★ GitHub</a>
    </header>

    <main id="top">
      <!-- Hero: the loop IS the logo -->
      <section class="wrap hero">
        <div>
          <h1>Build, review and ship WordPress, in one <span class="hl">loop.</span></h1>
          <p class="lede">
            Model your content types, write hooks and APIs in modern PHP, review every change in a
            PR and ship it to every environment. When the live site changes, pull it back and go
            around again. Your content never moves.
          </p>
          <div class="ctas">
            <code class="chip">$ npm i -g @loopress/cli</code>
            <a href="/docs" class="btn">Get started</a>
          </div>
          <p class="mono hint">then <code>lps project config</code> connects your site and installs the plugin for you.</p>
        </div>

        <figure>
          <svg viewBox="-70 20 610 370" class="w-full" role="img" aria-label="The Loopress hexagon as a loop: Build, Review and Ship on the repo side, the live site on the cyan side, pull back along the bottom to Build">
            <path d={repoSide} class="seg-repo" />
            <path d={siteSide} class="seg-site" />
            <path d={pullBack} class="seg-pull" />
            <circle r="9" class="dot"><animateMotion dur="8s" repeatCount="indefinite" path={outline} /></circle>
            {[L, TL, TR].map((p) => <circle cx={p[0]} cy={p[1]} r="15" class="node" />)}
            <text x={L[0] - 30} y={L[1] + 7} text-anchor="end" class="lbl">Build</text>
            <text x={TL[0]} y={TL[1] - 30} text-anchor="middle" class="lbl">Review</text>
            <text x={TR[0]} y={TR[1] - 30} text-anchor="middle" class="lbl">Ship</text>
            <text x={R[0] + 32} y={R[1] - 4} class="lbl lbl-site">your live site</text>
            <text x={R[0] + 32} y={R[1] + 18} class="sub">wp-admin edits happen here</text>
            <text x="200" y={BL[1] + 44} text-anchor="middle" class="lbl">↺ pull back</text>
            <text x="200" y="200" text-anchor="middle" class="sub">your repo</text>
            <text x="200" y="218" text-anchor="middle" class="sub">config + code, never content</text>
          </svg>
          <figcaption class="aside text-center">the whole idea, on one hexagon.</figcaption>
        </figure>
      </section>

      <!-- Scope: what "in Git" means, concretely -->
      <section id="scope" class="scope">
        <div class="wrap py-24">
          <h2 class="max-w-3xl">Everything but the content, in Git.</h2>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed">
            Your repo holds how the site is built and behaves. What your client writes stays in
            WordPress, where it belongs.
          </p>
          <div class="scope-grid">
            <pre class="tree"><span class="dim">$ tree client-site</span>{"\n"}client-site/{"\n"}├── {tree.map(([line, comment, kind]) => (
              <>{line}{comment && <span class={`cmt ${kind}`}>{"  "}# {comment}</span>}{"\n"}</>
            ))}</pre>
            <div>
              <table class="tracked">
                <tbody>
                  {tracked.map(([what, edition]) => (
                    <tr>
                      <td>{what}</td>
                      <td class={`ed ${edition === "Full" ? "ed-full" : "ed-light"}`}>{edition}</td>
                    </tr>
                  ))}
                  <tr class="never">
                    <td>Posts, pages content, orders, users, media</td>
                    <td class="ed">never</td>
                  </tr>
                </tbody>
              </table>
              <p class="aside mt-5"><code class="mono">lps diff</code> exits 0 in sync, 1 on drift. that's your CI gate.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- The week: stages as moments, marked by the hexagon segment they light -->
      <section id="week" class="week">
        <div class="wrap py-24">
          <h2 class="max-w-3xl">One week, five client sites, the same loop every time.</h2>
          <ul class="sites mt-8">
            {sites.map((s) => <li>{s}</li>)}
          </ul>
          <ol class="timeline mt-16">
            {week.map((e) => (
              <li class={e.stage === "Pull back" ? "is-pull" : ""}>
                <svg viewBox="50 60 300 280" class="minihex" aria-hidden="true">
                  <path d={outline} class="mini-base" />
                  <path d={segment[e.stage]} class="mini-on" />
                </svg>
                <div>
                  <p class="mono meta"><span class="stage">{e.tag ?? e.stage}</span> · {e.when} · {e.site}</p>
                  <h3>{e.ask}</h3>
                  <p class="body">{e.body}</p>
                </div>
                <div class="side">
                  <pre>{e.code}</pre>
                  <p class="aside">{e.note}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Editions: same idiom as the scope section (dark mono block, real content). The nesting
           of the tree says "Full contains Light" on its own. -->
      <section id="editions" class="wrap editions">
        <div>
          <h2>Full = Light + your code.</h2>
          <p class="mt-6 text-lg leading-relaxed">
            <strong>Light</strong> puts your configuration in Git. It is on WordPress.org.
          </p>
          <p class="mt-4 text-lg leading-relaxed">
            <strong>Full</strong> is the same plugin with the code half switched on, with
            conventions instead of <code class="mono">functions.php</code>.{" "}
            <code class="mono">lps project config</code> installs it for you.
          </p>
          <p class="aside mt-6">both free. WordPress.org doesn't host plugins that deploy code, that's the whole reason there are two.</p>
        </div>
        <pre class="tree"><span class="dim">$ tree loopress-full</span>
<span class="t-full">loopress-full/</span>              <span class="cmt"># loopress.dev, via lps project config</span>
├── <span class="t-light">loopress-light/</span>         <span class="cmt"># WordPress.org</span>
│   ├── acf/  seo/  menus/
│   └── options/  theme/
└── <span class="t-full">+ your code</span>
    ├── hooks/  api/  apps/  pages/
    ├── snippets/
    └── composer.json          <span class="cmt"># plugin lockfile</span></pre>
      </section>

      <section class="close">
        <div class="wrap py-20">
          <h2>Open source, and yours to keep.</h2>
          <p class="mono install">$ npm i -g @loopress/cli<span class="caret" aria-hidden="true">_</span></p>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a href="/docs" class="btn btn-invert">Get started</a>
            <a href="https://github.com/loopress" class="mono text-sm underline">★ Star on GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="wrap flex flex-wrap items-center justify-between gap-4 py-8 text-sm">
      <Logo class="h-6 w-6" />
      <span class="mono text-xs">CLI MPL-2.0 · plugin GPL · docs · github</span>
    </footer>
  </div>
</Layout>

<style>
  /* Hallmark · macrostructure: Brand-led loop + scope + timeline · tone: graphic, warm-technical · anchor hue: 215 (logo cyan) */
  .page {
    --paper: oklch(0.975 0.008 95);
    --paper-2: oklch(0.94 0.012 95);
    --navy: oklch(0.22 0.05 255);
    --cyan: oklch(0.76 0.14 215);
    --cyan-ink: oklch(0.5 0.12 225);
    --cyan-soft: color-mix(in oklch, var(--cyan) 22%, white);
    --yellow: oklch(0.88 0.16 95);
    --violet: oklch(0.55 0.18 290);
    --font-display: "Bricolage Grotesque", system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
    --logo-accent: var(--cyan);
    background: var(--paper);
    color: var(--navy);
    font-family: var(--font-display);
    overflow-x: clip;
  }
  .wrap { margin-inline: auto; max-width: 72rem; padding-inline: 1.5rem; }
  .mono { font-family: var(--font-mono); }
  a:hover { color: var(--cyan-ink); }
  .topnav { gap: 1.75rem; }
  h1, h2, h3 { font-weight: 800; letter-spacing: -0.035em; line-height: 1; overflow-wrap: anywhere; min-width: 0; }
  h1 { font-size: clamp(2.6rem, 5.5vw, 4.6rem); }
  h2 { font-size: clamp(2rem, 4vw, 3.25rem); }
  h3 { font-size: 1.6rem; letter-spacing: -0.02em; line-height: 1.15; }
  .hl { background: var(--yellow); padding-inline: 0.12em; box-decoration-break: clone; }
  .aside { font-weight: 500; color: var(--cyan-ink); }
  .aside::before { content: "// "; font-family: var(--font-mono); opacity: 0.7; }

  /* Hero */
  .hero { display: grid; gap: 2.5rem; padding-block: 2rem 6rem; align-items: center; }
  @media (min-width: 1024px) { .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .lede { margin-top: 1.75rem; max-width: 34rem; font-size: 1.15rem; line-height: 1.6; }
  .ctas { margin-top: 2.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .hint { margin-top: 1rem; font-size: 0.75rem; opacity: 0.7; }
  .chip { font-family: var(--font-mono); border: 2px solid var(--navy); padding: 0.6rem 1rem; border-radius: 0.5rem; background: var(--paper); }
  .btn { display: inline-flex; align-items: center; height: 2.9rem; padding-inline: 1.4rem; border-radius: 0.5rem; background: var(--navy); color: var(--paper); font-weight: 800; }
  .btn:hover { background: var(--cyan); color: var(--navy); }
  .btn-invert { background: var(--yellow); color: var(--navy); }

  .seg-repo, .seg-site, .seg-pull { fill: none; stroke-linejoin: round; stroke-linecap: round; }
  .seg-repo { stroke: var(--navy); stroke-width: 26; }
  .seg-site { stroke: var(--cyan); stroke-width: 26; }
  .seg-pull { stroke: var(--paper); stroke-width: 3; stroke-dasharray: 8 9; stroke-linecap: butt; }
  .node { fill: var(--paper); stroke: var(--navy); stroke-width: 4; }
  .dot { fill: var(--yellow); stroke: var(--navy); stroke-width: 3; }
  .lbl { font-size: 20px; font-weight: 800; fill: var(--navy); }
  .lbl-site { fill: var(--cyan-ink); }
  .sub { font-family: var(--font-mono); font-size: 11px; fill: var(--navy); opacity: 0.7; }

  /* Scope */
  .scope { background: var(--navy); color: var(--paper); }
  .scope .aside { color: var(--cyan); }
  .scope-grid { margin-top: 3rem; display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 1024px) { .scope-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
  .tree { background: oklch(0.17 0.04 255); border-radius: 0.75rem; padding: 1.4rem 1.5rem; font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.85; overflow-x: auto; }
  .dim { opacity: 0.6; }
  .cmt { opacity: 0.55; }
  .cmt.light { color: var(--cyan); opacity: 1; }
  .cmt.full { color: oklch(0.78 0.13 290); opacity: 1; }
  .tracked { width: 100%; font-size: 1rem; }
  .tracked td { padding: 0.7rem 0; border-bottom: 1px solid oklch(1 0 0 / 0.14); }
  .ed { text-align: right; font-family: var(--font-mono); font-size: 0.78rem; }
  .ed-light { color: var(--cyan); }
  .ed-full { color: oklch(0.78 0.13 290); }
  .never td { opacity: 0.6; border-bottom: 0; }

  /* The week */
  .week { background: var(--paper-2); }
  .sites { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .sites li { font-family: var(--font-mono); font-size: 0.8rem; padding: 0.35rem 1rem; background: var(--navy); color: var(--paper); clip-path: polygon(0.6rem 0, calc(100% - 0.6rem) 0, 100% 50%, calc(100% - 0.6rem) 100%, 0.6rem 100%, 0 50%); }
  .timeline { position: relative; display: grid; isolation: isolate; }
  .timeline::before { content: ""; position: absolute; left: 0.9rem; top: 0.5rem; bottom: 0.5rem; width: 3px; background: var(--navy); border-radius: 2px; }
  .timeline li { position: relative; display: grid; gap: 1.5rem; padding: 0 0 4rem 3.5rem; }
  @media (min-width: 1024px) { .timeline li { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 3rem; } }
  .timeline li.is-pull { padding-right: 1.5rem; }
  .timeline li.is-pull::before { content: ""; position: absolute; left: 0.9rem; top: -1rem; bottom: 0; width: 3px; background: var(--cyan); }
  .timeline li.is-pull::after { content: ""; position: absolute; inset: -1.5rem 0 2.5rem 2.4rem; z-index: -1; border-radius: 1rem; background: var(--cyan-soft); }
  .minihex { position: absolute; left: -0.35rem; top: -0.2rem; width: 2.6rem; height: 2.6rem; background: var(--paper-2); }
  .is-pull .minihex { background: transparent; }
  .mini-base, .mini-on { fill: none; stroke-linejoin: round; stroke-linecap: round; stroke-width: 34; }
  .mini-base { stroke: color-mix(in oklch, var(--navy) 18%, transparent); }
  .mini-on { stroke: var(--navy); }
  .is-pull .mini-on { stroke: var(--cyan); }
  .meta { font-size: 0.8rem; opacity: 0.8; }
  .stage { font-weight: 500; background: var(--navy); color: var(--paper); padding: 0.1rem 0.45rem; border-radius: 0.25rem; }
  .is-pull .stage { background: var(--cyan); color: var(--navy); }
  .timeline h3 { margin-top: 0.75rem; }
  .body { margin-top: 0.75rem; font-size: 1.05rem; line-height: 1.6; max-width: 36rem; }
  .side pre { background: var(--navy); color: var(--paper); border-radius: 0.75rem; padding: 1.1rem 1.25rem; font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.75; overflow-x: auto; }
  .side .aside { margin-top: 0.9rem; }

  /* Editions */
  .editions { display: grid; gap: 3rem; padding-block: 7rem; align-items: center; }
  @media (min-width: 1024px) { .editions { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }
  .editions .tree { background: var(--navy); color: var(--paper); }
  .t-light { color: var(--cyan); font-weight: 500; }
  .t-full { color: oklch(0.78 0.13 290); font-weight: 500; }

  /* Close */
  .close { background: var(--navy); color: var(--paper); }
  .close a:hover { color: var(--yellow); }
  .install { margin-top: 1.5rem; font-size: clamp(1.4rem, 4.5vw, 3.5rem); font-weight: 500; white-space: nowrap; overflow-x: auto; }
  .caret { color: var(--yellow); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .dot { display: none; }
    .caret { animation: none; }
  }
</style>
