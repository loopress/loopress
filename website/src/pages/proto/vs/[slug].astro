---
// Prototype: one comparison page per alternative (/proto/vs/bedrock, ...), data in
// components/proto/alternatives.ts. Each page says when the other tool is the better pick, and
// when to use both: a comparison that only flatters Loopress reads as an ad. Throwaway, not linked.
import DocPage from "@/components/proto/DocPage.astro";
import { alternatives, type Alternative } from "@/components/proto/alternatives";

export const prerender = true;

export function getStaticPaths() {
  return alternatives.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props as { a: Alternative };
---

<DocPage title={`${a.heading.replace(/\.$/, "")} - Loopress`} kicker={`compare · ${a.kind}`} heading={a.heading} lede={a.lede} wide>
  <table class="vs">
    <thead>
      <tr><th></th><th>{a.name}</th><th>Loopress</th></tr>
    </thead>
    <tbody>
      {a.rows.map(([topic, them, us]) => (
        <tr><th scope="row">{topic}</th><td>{them}</td><td>{us}</td></tr>
      ))}
    </tbody>
  </table>

  {a.task && (
    <>
      <h2>Same task, both ways</h2>
      <p class="task">{a.task.title}.</p>
      <div class="ways">
        <div>
          <p class="mono way">{a.name}</p>
          <ol>{a.task.them.map((step) => <li>{step}</li>)}</ol>
        </div>
        <div>
          <p class="mono way">Loopress</p>
          <pre>{a.task.us}</pre>
        </div>
      </div>
    </>
  )}

  <div class="picks">
    <div>
      <h2>Pick {a.name} when</h2>
      <p>{a.theirs}</p>
    </div>
    <div>
      <h2>Pick Loopress when</h2>
      <p>{a.ours}</p>
    </div>
  </div>

  {a.together && (
    <>
      <h2>Or use both</h2>
      <p>{a.together}</p>
    </>
  )}

  <p class="others">
    <a href="/proto/vs">All comparisons</a> ·{" "}
    {alternatives.filter((o) => o.slug !== a.slug).map((o, i) => (
      <>{i > 0 && " · "}<a href={`/proto/vs/${o.slug}`}>{o.name}</a></>
    ))}
  </p>
</DocPage>

<style>
  .vs { width: 100%; font-size: 0.95rem; }
  .vs th, .vs td { padding: 0.9rem 1rem 0.9rem 0; border-bottom: 1px solid color-mix(in oklch, currentColor 15%, transparent); text-align: left; vertical-align: top; }
  .vs thead th { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 500; }
  .vs tbody th { font-weight: 800; width: 28%; }
  .vs td:last-child { color: var(--cyan-ink); font-weight: 500; }

  .task { font-size: 1.15rem; }
  .ways { margin-top: 1.5rem; display: grid; gap: 1.5rem; }
  @media (min-width: 768px) { .ways { grid-template-columns: 1fr 1fr; } }
  .way { font-size: 0.8rem; margin-bottom: 0.75rem; }
  .ways ol { list-style: decimal; padding-left: 1.25rem; }
  .ways ol li + li { margin-top: 0.5rem; }
  .ways pre { margin-top: 0; }

  .picks { display: grid; gap: 0 3rem; }
  @media (min-width: 768px) { .picks { grid-template-columns: 1fr 1fr; } }

  .others { margin-top: 4rem; font-size: 0.95rem; }
  @media (max-width: 640px) {
    .vs thead { display: none; }
    .vs tr { display: block; padding-block: 0.75rem; border-bottom: 1px solid color-mix(in oklch, currentColor 15%, transparent); }
    .vs th, .vs td { display: block; border: 0; padding: 0.2rem 0; width: auto !important; }
  }
</style>
