---
// Prototype: the comparison overview, one matrix of every alternative against the same criteria,
// each row linking to its page. Throwaway, not linked.
import DocPage from "@/components/proto/DocPage.astro";
import { alternatives, criteria, gapCriteria, loopressGaps, loopressMatrix } from "@/components/proto/alternatives";

export const prerender = true;

const tables = [
  { title: "What it does", cols: criteria, us: loopressMatrix, cells: (a: (typeof alternatives)[number]) => a.matrix },
  { title: "What Loopress doesn't do", cols: gapCriteria, us: loopressGaps, cells: (a: (typeof alternatives)[number]) => a.gaps },
];

// "yes" / "no" read at a glance, anything longer is a nuance worth reading.
const tone = (cell: string) => (cell === "yes" || cell === "always" || cell.startsWith("yes,") ? "y" : cell === "no" ? "n" : "m");
---

<DocPage title="Compare - Loopress" kicker="compare" heading="Loopress, next to what you use today." lede="Most WordPress devs already have a way to move changes between sites. Here is where each one fits, and where Loopress does something different." wide>
  {tables.map((t) => (
    <>
      <h2>{t.title}</h2>
      <div class="scroll">
        <table class="matrix">
          <thead>
            <tr>
              <th></th>
              {t.cols.map((c) => <th scope="col">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr class="us">
              <th scope="row">Loopress</th>
              {t.us.map((cell) => <td class={tone(cell)}>{cell}</td>)}
            </tr>
            {alternatives.map((a) => (
              <tr>
                <th scope="row"><a href={`/proto/vs/${a.slug}`}>{a.name}</a><span class="kind">{a.kind}</span></th>
                {t.cells(a).map((cell) => <td class={tone(cell)}>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ))}
  <p class="aside">loopress moves configuration and code, nothing else. keep your backup and migration tools, they do a different job.</p>

  <h2>The short version</h2>
  <ul class="short">
    {alternatives.map((a) => (
      <li><a href={`/proto/vs/${a.slug}`}><strong>{a.name}</strong></a>: {a.lede}</li>
    ))}
  </ul>
</DocPage>

<style>
  .scroll { margin-top: 1.25rem; overflow-x: auto; }
  .matrix { width: 100%; min-width: 44rem; font-size: 0.85rem; }
  .matrix th, .matrix td { padding: 0.8rem 0.75rem 0.8rem 0; border-bottom: 1px solid color-mix(in oklch, currentColor 15%, transparent); text-align: left; vertical-align: top; }
  .matrix thead th { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; }
  .matrix tbody th { font-weight: 800; min-width: 10rem; }
  .kind { display: block; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500; opacity: 0.6; }
  .us th, .us td { background: color-mix(in oklch, var(--cyan) 14%, transparent); }
  .us th { padding-left: 0.75rem; }
  .y { font-weight: 800; }
  .n { opacity: 0.45; }
  .m { font-style: italic; }
  .short li { margin-top: 0.75rem; }
</style>
