{
  "name": "@loopress/wordpress-plugin",
  "version": "2026.13.0",
  "private": true,
  "scripts": {
    "prebuild": "mkdir -p assets && cp node_modules/@loopress/assets/loopress-logo-full-white.svg assets/logo.svg",
    "build": "wp-scripts build frontend/full/index.tsx",
    "dev:light": "wp-scripts start frontend/light/index.tsx",
    "dev:full": "wp-scripts start frontend/full/index.tsx",
    "type-check": "tsc --noEmit",
    "lint": "eslint frontend",
    "test": "vitest run",
    "pack:light": "pnpm run prebuild && node scripts/build-flavor.cjs light",
    "pack:full": "pnpm run prebuild && node scripts/build-flavor.cjs full",
    "pack": "pnpm run pack:light && pnpm run pack:full",
    "version": "node scripts/sync-version.js && git add loopress.php readme.txt flavors/light/readme.txt"
  },
  "dependencies": {
    "@loopress/assets": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@wordpress/admin-ui": "^2.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@loopress/eslint-config": "workspace:*",
    "@svgr/webpack": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wordpress/components": "^41.0.0",
    "@wordpress/element": "^8.8.0",
    "@wordpress/scripts": "36.0.0",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "url-loader": "^4.1.1",
    "vitest": "^5.0.3"
  }
}
