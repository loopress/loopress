includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: 10
    strictRules:
        # Off on purpose: array<string, ...> keys arrive as int at runtime for numeric keys, and WP
        # objects/options carry DB strings their stubs type as int, so with strict_types these
        # "useless" casts are what keeps a TypeError out.
        uselessCast: false
    # Same threshold as sonarjs/cognitive-complexity in the CLI (eslint-plugin-sonarjs recommended).
    cognitive_complexity:
        function: 15
        class: 1000 # Sonar has no class-level rule, so this one is effectively off.
    checkUninitializedProperties: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    reportAnyTypeWideningInVarTag: true
    checkMissingCallableSignature: true
    rememberPossiblyImpureFunctionValues: false
    # Treats array keys as the int|string they really are: a numeric string key is an int at runtime.
    checkBenevolentUnionTypes: true
    paths:
        - src
        - tests
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - stubs/code-snippets-stubs.php
        - stubs/acf-stubs.php
        - stubs/wpforms-stubs.php
        - stubs/phpstan-constants.php
    dynamicConstantNames:
        - LOOPRESS_PLUGIN_URL
        - LOOPRESS_PLUGIN_PATH
        - LOOPRESS_PLUGIN_SLUG
        - LOOPRESS_VERSION
    excludePaths:
        - vendor
        # Test-only WP class doubles and constants: analysed, they'd shadow the real WordPress
        # stubs and constants src/ is checked against.
        - tests/Stubs/WpRestStubs.php
        - tests/bootstrap.php

    ignoreErrors:
        # strict-rules wants self::assertSame(); $this->assertSame() is PHPUnit's documented style.
        - identifier: staticMethod.dynamicCall
          path: tests/*

        # Test-control hooks that only the WpRestStubs.php doubles have, not WordPress: a test
        # sets a malformed JSON body, declares registered blocks, seeds or resets the pattern
        # registry, or reads the admin bar nodes a module added.
        - message: '#^Call to an undefined method WP_REST_Request(<.+>)?::set_json_params\(\)\.$#'
          path: tests/*
        - message: '#^Access to an undefined static property WP_Block_Type_Registry::\$registered\.$#'
          path: tests/*
        - message: '#^Call to an undefined static method WP_Block_Patterns_Registry::reset\(\)\.$#'
          path: tests/*
        - message: '#^Access to an undefined property WP_Block_Patterns_Registry::\$patterns\.$#'
          path: tests/*
        - message: '#^Access to an undefined property WP_Admin_Bar::\$nodes\.$#'
          path: tests/*

        # Route fixtures are read through reflection (verb methods, attributes), never called.
        - identifier: method.unused
          path: tests/Unit/*/RestApi/*Fixture*.php

        # The stub types wpdb::prepare()'s query as literal-string, but a table name is always
        # interpolated from $wpdb (`{$wpdb->posts}`), and an IN list is a generated run of %s
        # placeholders. Every value still goes through prepare()'s placeholders.
        - message: '#^Parameter \#1 \$query of method wpdb::prepare\(\) expects literal-string, .+ given\.$#'
          paths:
              - src/Content/Service/ContentService.php
              - src/Options/Service/OptionsService.php

        # register_post_type()/register_taxonomy()/register_post_meta() get a cpt/, taxonomies/ or
        # meta file's arguments as-is: their shape is the user's file, checked by WordPress itself,
        # not narrowed key by key to the stub's array shape. Same exception as psalm.xml's
        # ArgumentTypeCoercion on src/PostTypes.
        - message: '#^Parameter \#\d+ \$args of function register_(post_type|taxonomy|post_meta) expects array\{#'
          path: src/PostTypes/Service/*

        # checkSyntax() calls token_get_all() for the ParseError it throws, not its tokens.
        - identifier: function.resultUnused
          path: src/Infrastructure/AbstractFilesController.php

        # WP_REST_Request::get_json_params()'s bundled stub says `@return array` (no `|null`),
        # but the real core implementation (wp-includes/rest-api/class-wp-rest-request.php)
        # leaves $this->params['JSON'] at null for an empty body, a non-JSON content type, or
        # malformed JSON, get_json_params() ignores parse_json_params()'s WP_Error return in
        # that last case and just returns whatever was left (also true for a literal JSON `null`
        # body: json_decode() itself returns null, no error). The is_array() guard here is real
        # defensive code against that gap between the stub and WordPress's actual behavior, not
        # dead code, verified by reading WP core directly, not just the stub.
        - message: '#Call to function is_array\(\) with array will always evaluate to true#'
          paths:
              - src/Form/RestApi/FormController.php
              - src/Options/RestApi/OptionsController.php
              - src/Menu/RestApi/MenuController.php
              - src/PostTypes/RestApi/DeclaredTypesController.php
              - src/Content/RestApi/ContentController.php

