<?xml version="1.0"?>
<psalm
    errorLevel="3"
    phpVersion="8.2"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
>
    <projectFiles>
        <directory name="src" />
        <file name="loopress.php" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <stubs>
        <file name="vendor/php-stubs/wordpress-stubs/wordpress-stubs.php" />
        <file name="stubs/psalm-stubs.php" />
        <file name="stubs/code-snippets-stubs.php" />
        <file name="stubs/acf-stubs.php" />
        <file name="stubs/wpforms-stubs.php" />
    </stubs>

    <issueHandlers>
        <!-- REST callback methods are invoked indirectly by WordPress via register_rest_route(),
             so Psalm can't trace calls to them, and their required WP_REST_Request $request
             is part of the callback contract even when a given endpoint doesn't read any params. -->
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="src/Acf/RestApi" />
                <directory name="src/Seo/RestApi" />
                <directory name="src/Dependencies/RestApi" />
                <directory name="src/Update/RestApi" />
                <directory name="src/Snippets/RestApi" />
                <directory name="src/Form/RestApi" />
                <directory name="src/Sentry/RestApi" />
                <directory name="src/Settings/RestApi" />
                <!-- ApiFilesController's endpoints are invoked by register_rest_route() like the
                     other RestApi/ directories above; RouteLoader::loadFile()/registerRoutesFor()
                     don't call this directly, but RouteLoader::applyHeaders() is invoked by WP core
                     via add_filter('rest_pre_serve_request', ...), same untraceable-by-Psalm shape. -->
                <directory name="src/Api/RestApi" />
                <!-- AppsController's endpoints are invoked by register_rest_route() like the
                     other RestApi/ directories above. -->
                <directory name="src/Apps/RestApi" />
                <!-- HookFilesController's endpoints are invoked by register_rest_route() like the
                     other RestApi/ directories above; HookLoader's own constructor is built
                     exclusively through the PHP-DI container, same untraceable-by-Psalm shape as
                     RouteLoader's below. -->
                <directory name="src/Hooks/RestApi" />
                <!-- OptionsController's endpoints are invoked by register_rest_route() like the
                     other RestApi/ directories above. -->
                <directory name="src/Options/RestApi" />
                <!-- AbstractFilesController::list_files()/push_file() are the shared base of
                     ApiFilesController and HookFilesController above: invoked by
                     register_rest_route() (through each subclass's register_routes()), never a
                     traceable call. -->
                <file name="src/Infrastructure/AbstractFilesController.php" />
                <!-- Built exclusively through the PHP-DI container (ContainerFactory, wired up
                     by Plugin.php and each Feature::definitions()): autowiring and
                     $container->make() call these reflectively, which Psalm can't trace back
                     to any literal `new`. -->
                <referencedMethod name="Loopress\Contract\FeatureProvider::definitions" />
                <referencedMethod name="Loopress\Contract\FeatureProvider::moduleClasses" />
                <referencedMethod name="Loopress\Acf\Module\AcfModule::__construct" />
                <referencedMethod name="Loopress\Seo\Module\SeoModule::__construct" />
                <referencedMethod name="Loopress\Options\Module\OptionsModule::__construct" />
                <referencedMethod name="Loopress\Dependencies\Infrastructure\LoopressEnvironment::__construct" />
                <referencedMethod name="Loopress\Dependencies\Infrastructure\ComposerRunner::__construct" />
                <referencedMethod name="Loopress\Dependencies\Service\ComposerService::__construct" />
                <referencedMethod name="Loopress\Dependencies\Module\ComposerModule::__construct" />
                <referencedMethod name="Loopress\Update\Module\UpdateCheckModule::__construct" />
                <referencedMethod name="Loopress\Snippets\Module\SnippetModule::__construct" />
                <referencedMethod name="Loopress\Update\Infrastructure\GithubReleaseChecker::__construct" />
                <referencedMethod name="Loopress\Dependencies\Infrastructure\PackagistClient::__construct" />
                <referencedMethod name="Loopress\Form\Module\FormModule::__construct" />
                <referencedMethod name="Loopress\Api\Module\ApiModule::__construct" />
                <!-- ApiDirectory/HooksDirectory no longer declare their own constructor; the
                     PHP-DI container instantiates them through this inherited base one. -->
                <referencedMethod name="Loopress\Infrastructure\AbstractFilesDirectory::__construct" />
                <referencedMethod name="Loopress\Apps\Module\AppsModule::__construct" />
                <referencedMethod name="Loopress\Apps\Frontend\AppShortcode::__construct" />
                <referencedMethod name="Loopress\Apps\Frontend\AppAssetEnqueuer::__construct" />
                <referencedMethod name="Loopress\Apps\Infrastructure\AppsDirectory::__construct" />
                <!-- Same untraceable-by-Psalm shape as the DI-container constructors above, but a
                     different reflective caller: RouteLoader::permissionAttributeFor() reads this
                     via ReflectionAttribute::newInstance(), never a literal `new Permission(...)`. -->
                <referencedMethod name="Loopress\Api\Attribute\Permission::__construct" />
                <!-- Same reflective-attribute shape as Permission::__construct above:
                     RouteLoader::cronMethodsFor() reads this via ReflectionAttribute::newInstance(). -->
                <referencedMethod name="Loopress\Hooks\Module\HooksModule::__construct" />
                <!-- Same reflective-attribute shape as Permission::__construct above:
                     HookLoader::actionMethodsFor()/filterMethodsFor()/cronMethodsFor() read these
                     via ReflectionAttribute::newInstance(). -->
                <referencedMethod name="Loopress\Hooks\Attribute\Action::__construct" />
                <referencedMethod name="Loopress\Hooks\Attribute\Filter::__construct" />
                <referencedMethod name="Loopress\Hooks\Attribute\Cron::__construct" />
            </errorLevel>
        </PossiblyUnusedMethod>
        <PossiblyUnusedParam>
            <errorLevel type="suppress">
                <directory name="src/Acf/RestApi" />
                <directory name="src/Seo/RestApi" />
                <directory name="src/Dependencies/RestApi" />
                <directory name="src/Update/RestApi" />
                <directory name="src/Snippets/RestApi" />
                <directory name="src/Form/RestApi" />
                <!-- list_options() keeps $request for the register_rest_route() callback contract
                     even though its only remaining use (the removed ?quick_source flag) is gone. -->
                <directory name="src/Options/RestApi" />
                <!-- $result in RouteLoader::applyHeaders() is part of the rest_pre_serve_request
                     filter signature (served, result, request, server), unused here but required
                     to keep positional args aligned with the ones actually needed. -->
                <directory name="src/Api/RestApi" />
                <!-- AppShortcode::render()'s $content and $tag complete the do_shortcode callback
                     signature; this shortcode reads neither. -->
                <directory name="src/Apps/Frontend" />
            </errorLevel>
        </PossiblyUnusedParam>

        <!-- WP_REST_Request::get_param() is typed as nullable by the WordPress stubs, but the
             route's own `args` schema marks these as required, so WordPress rejects the request
             before the callback runs if they're missing. -->
        <PossiblyNullArgument>
            <errorLevel type="suppress">
                <directory name="src/Acf/RestApi" />
                <directory name="src/Seo/RestApi" />
                <directory name="src/Dependencies/RestApi" />
                <directory name="src/Snippets/RestApi" />
                <directory name="src/Form/RestApi" />
            </errorLevel>
        </PossiblyNullArgument>

        <!-- Registered as a `rest_post_dispatch`/`rest_pre_serve_request` filter; the return
             value is consumed by WordPress's filter chain, not by any caller Psalm can see. -->
        <PossiblyUnusedReturnValue>
            <errorLevel type="suppress">
                <file name="src/RestCache/Module/RestCacheModule.php" />
                <file name="src/Api/RestApi/RouteLoader.php" />
                <!-- render() is the [loopress_app] shortcode callback and filterModuleType() a
                     script_loader_tag filter; WordPress consumes both return values through a
                     hook chain Psalm can't trace to a caller. -->
                <file name="src/Apps/Frontend/AppShortcode.php" />
                <file name="src/Apps/Frontend/AppAssetEnqueuer.php" />
            </errorLevel>
        </PossiblyUnusedReturnValue>

        <!-- #[\Override] is a PHP 8.3+ builtin attribute; this project's platform (composer.json,
             config.platform.php) targets 8.2, so it isn't used here despite phpVersion being set. -->
        <MissingOverrideAttribute errorLevel="suppress" />

        <!-- require_once ABSPATH . 'wp-admin/includes/...' paths only resolve inside a real
             WordPress install, which isn't present in this analysis environment. -->
        <MissingFile errorLevel="suppress" />

        <!-- Invoked via a dynamic class-string ("\Loopress\{$feature}\Feature"::bootstrap())
             in loopress.php's Plus-feature loop, which Psalm can't trace back to this call site. -->
        <UnusedClass>
            <errorLevel type="suppress">
                <file name="src/Dependencies/Feature.php" />
                <file name="src/Update/Feature.php" />
                <file name="src/Snippets/Feature.php" />
                <file name="src/Form/Feature.php" />
                <file name="src/Sentry/Feature.php" />
                <file name="src/Settings/Feature.php" />
                <file name="src/Api/Feature.php" />
                <file name="src/Hooks/Feature.php" />
                <file name="src/Apps/Feature.php" />
            </errorLevel>
        </UnusedClass>
    </issueHandlers>
</psalm>
